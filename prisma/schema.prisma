/// A voucher: receipt, payment, contra or journal; made by hand or posted by the software.
model AccVoucher {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// receipt | payment | contra | journal
  type         String
  number       String
  date         DateTime  @db.Date
  narration    String?
  /// Cheque / UPI / transfer reference.
  reference    String?
  total        Float     @default(0)
  /// pending (approval) | posted | cancelled
  status       String    @default("posted")
  /// manual | fees | payroll | salary_paid | store | loan
  source       String    @default("manual")
  /// What it was posted from, so it is never posted twice (fees:2026-10-01, payroll:2026-09, grn:<id>…).
  sourceKey    String?   @map("source_key")
  attachmentId String?   @map("attachment_id") @db.Uuid
  createdBy    String?   @map("created_by") @db.Uuid
  approvedBy   String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason")
  isDemo       Boolean   @default(false) @map("is_demo")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries AccEntry[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, date])
  @@map("acc_vouchers")
}

/// A debit or credit line of a voucher; bank lines are ticked off against the bank statement.
model AccEntry {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  voucherId    String    @map("voucher_id") @db.Uuid
  ledgerId     String    @map("ledger_id") @db.Uuid
  dr           Float     @default(0)
  cr           Float     @default(0)
  note         String?
  /// The day it showed in the bank statement (bank reconciliation).
  reconciledOn DateTime? @map("reconciled_on") @db.Date

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voucher AccVoucher @relation(fields: [voucherId, tenantId], references: [id, tenantId], onDelete: Cascade)
  ledger  AccLedger  @relation(fields: [ledgerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, ledgerId])
  @@index([tenantId, voucherId])
  @@map("acc_entries")
}

