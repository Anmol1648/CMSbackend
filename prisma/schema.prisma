  @@index([tenantId, staffId, effectiveFrom])
  @@map("staff_salaries")
}

/// A month's payroll: prepared from attendance and leave, approved, then finalised (locked).
model PayrollRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// YYYY-MM
  month        String
  /// prepared | approved | finalised
  status       String    @default("prepared")
  /// Days the month's pay is divided by.
  totalDays    Float     @map("total_days")
  preparedBy   String?   @map("prepared_by") @db.Uuid
