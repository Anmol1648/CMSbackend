  reason       String
  /// pending | approved | rejected | cancelled
  status       String    @default("pending")
  /// The user who asked (parent or student).
  appliedBy    String?   @map("applied_by") @db.Uuid
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")
  isDemo       Boolean   @default(false) @map("is_demo")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("student_leaves")
}

/// A staff member asks the office to put a day right (forgot to check in, on duty elsewhere).
model StaffAttendanceRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  date         DateTime  @db.Date
  /// "08:05" (India time); empty = not asked to change.
  checkIn      String?   @map("check_in")
  checkOut     String?   @map("check_out")
  reason       String
  /// pending | approved | rejected | cancelled
  status       String    @default("pending")
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("staff_attendance_requests")
}

/// A place staff may check in at (the school, a second campus): a point and a radius.
model AttendanceLocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  latitude  Float
  longitude Float
  /// Metres around the point that count as "at school".
  radius    Int      @default(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("attendance_locations")
}

/// A staff member's enrolled face (for face check at check-in): descriptors from a few photos.
model StaffFace {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  /// [[128 numbers], …]: one per enrolment photo.
  descriptors Json
  /// The enrolment photos (files), for the office to see.
  photoIds    String[]  @default([]) @map("photo_ids") @db.Uuid
  /// pending (the person enrolled themselves) | approved
  status      String    @default("approved")
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([staffId, tenantId])
  @@map("staff_faces")
}

/// The phone a staff member checks in from (registered-phone lock): a fingerprint of the browser, not the phone number.
model StaffPhone {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  /// SHA-256 of the random id the browser keeps.
  deviceHash String   @map("device_hash")
  /// What it is, as the browser says (e.g. "Chrome on Android").
  label      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([staffId, tenantId])
  @@map("staff_phones")
}

/// An attendance machine or system that sends punches: an eSSL / ZKTeco machine (ADMS push), another
/// system calling our web address (webhook), or files exported from a machine (import).
model AttendanceDevice {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  /// essl_adms | webhook | import
  kind        String
  /// The machine's serial number (ADMS machines say it with every call).
  serialNo    String?   @unique @map("serial_no")
  /// The secret in the webhook address.
  token       String    @unique
  isActive    Boolean   @default(true) @map("is_active")
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  lastPunchAt DateTime? @map("last_punch_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  punches AttendancePunch[]

  @@unique([id, tenantId])
  @@map("attendance_devices")
}

/// One punch from a machine or system: who (their machine number) and when. Turned into the person's
/// check-in (first punch of the day) and check-out (last).
model AttendancePunch {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  deviceId     String?  @map("device_id") @db.Uuid
  deviceUserId String   @map("device_user_id")
  /// The staff member it belongs to (null while the number isn't matched to anyone).
  staffId      String?  @map("staff_id") @db.Uuid
  punchedAt    DateTime @map("punched_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device AttendanceDevice? @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: SetNull)
  staff  Staff?            @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: SetNull)

  @@unique([tenantId, deviceUserId, punchedAt])
  @@index([tenantId, punchedAt])
  @@map("attendance_punches")
}

// ─── Staff leave ─────────────────────────────────────────────────────────────

/// A kind of staff leave and its rules (Leave → Leave Setup).
model LeaveType {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  code              String
  name              String
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  /// Days a leave year; null = no limit (leave without pay, on duty).
  quota             Float?
  /// yearly = all at the start of the leave year; monthly = a twelfth each month; none = only what is granted (comp-off).
  credit            String   @default("yearly")
  /// Joining during the year gives a share of the quota.
  prorate           Boolean  @default(true)
  /// At the year end: none | all | upto (at most carryMax days).
  carryForward      String   @default("none") @map("carry_forward")
  carryMax          Float?   @map("carry_max")
  halfDay           Boolean  @default(true) @map("half_day")
  minDays           Float?   @map("min_days")
  maxDays           Float?   @map("max_days")
  /// Ask at least this many days before.
  noticeDays        Int      @default(0) @map("notice_days")
  /// Can be asked for up to this many days after (e.g. sick leave on return).
  backDays          Int      @default(7) @map("back_days")
  /// A certificate (attachment) is needed for more than this many days.
  certificateAfter  Float?   @map("certificate_after")
  /// More than the balance: block | lwp (the extra days are leave without pay) | allow (balance goes below zero).
  overdraw          String   @default("block")
  /// Holidays and weekly offs between leave days count as leave.
  sandwich          Boolean  @default(false)
  paid              Boolean  @default(true)
  /// On duty: the day counts as present.
  countsPresent     Boolean  @default(false) @map("counts_present")
  /// The attendance status the days get, by code (Masters → Attendance statuses).
  attendanceCode    String   @default("LV") @map("attendance_code")
  /// Who may take it (master values); empty = everyone.
  staffTypeIds      String[] @default([]) @map("staff_type_ids") @db.Uuid
  employmentTypeIds String[] @default([]) @map("employment_type_ids") @db.Uuid
  genderIds         String[] @default([]) @map("gender_ids") @db.Uuid
  /// Who approves: default (System Settings → Leave) | reports_to | two_level | office.
  approval          String   @default("default")
  /// Comp-off: earned by working on a day off; each earning lapses after compOffDays.
  isCompOff         Boolean  @default(false) @map("is_comp_off")
  compOffDays       Int?     @map("comp_off_days")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?  @map("updated_by") @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaves  StaffLeave[]
  entries LeaveEntry[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("leave_types")
}

/// Balance changes besides the policy's credit: carried forward, adjusted by HR, comp-off earned.
model LeaveEntry {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  leaveTypeId String    @map("leave_type_id") @db.Uuid
  /// The leave year it belongs to, by its first day.
  yearStart   DateTime  @map("year_start") @db.Date
  /// carry | adjust | compoff
  kind        String
  days        Float
  /// Comp-off: the day worked and when the earning lapses.
  workedOn    DateTime? @map("worked_on") @db.Date
  expiresOn   DateTime? @map("expires_on") @db.Date
  note        String?
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Staff     @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, staffId, yearStart])
  @@map("leave_entries")
}

/// A staff member's leave: asked, approved (in one or two steps), turned down or cancelled.
model StaffLeave {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  leaveTypeId  String    @map("leave_type_id") @db.Uuid
  fromDate     DateTime  @map("from_date") @db.Date
  toDate       DateTime  @map("to_date") @db.Date
  /// A one-day leave for half the day: first | second.
  half         String?
  /// Days it takes (holidays left out unless the type's sandwich rule counts them).
  days         Float
  /// Days beyond the balance taken as leave without pay.
  lwpDays      Float     @default(0) @map("lwp_days")
  reason       String
  /// A certificate or letter (file).
  attachmentId String?   @map("attachment_id") @db.Uuid
  /// pending | approved | rejected | cancelled
  status       String    @default("pending")
  /// 1 = waits for the first approver; 2 = for the final one (two-level approval).
  stage        Int       @default(1)
  appliedBy    String?   @map("applied_by") @db.Uuid
  firstBy      String?   @map("first_by") @db.Uuid
  firstAt      DateTime? @map("first_at") @db.Timestamptz(6)
  firstNote    String?   @map("first_note")
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  isDemo       Boolean   @default(false) @map("is_demo")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     Staff     @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, staffId, fromDate])
  @@index([tenantId, status])
  @@map("staff_leaves")
}

// ─── Notices and events ──────────────────────────────────────────────────────

/// A notice or circular for some or all of the school (notice board, My Notices).
model Notice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  title         String
  /// Plain text; **bold**, "- " lists and links are shown formatted.
  body          String
  /// Master "notice_category" (Circular, Exam notice…).
  categoryId    String?   @map("category_id") @db.Uuid
  /// Shown first and highlighted.
  important     Boolean   @default(false)
  /// draft | pending (waits for approval) | published
  status        String    @default("draft")
  /// Shown from (a later time = scheduled); set when published.
  publishAt     DateTime? @map("publish_at") @db.Timestamptz(6)
  /// Off the board after this day (still in the archive).
  expiresOn     DateTime? @map("expires_on") @db.Date
  /// Who it is for (any of these). Students / parents: the whole school, or only these classes / sections.
  forEveryone   Boolean   @default(false) @map("for_everyone")
  forAllStaff   Boolean   @default(false) @map("for_all_staff")
  roleIds       String[]  @default([]) @map("role_ids") @db.Uuid
  forStudents   Boolean   @default(false) @map("for_students")
  forParents    Boolean   @default(false) @map("for_parents")
  classIds      String[]  @default([]) @map("class_ids") @db.Uuid
  sectionIds    String[]  @default([]) @map("section_ids") @db.Uuid
  /// Readers press "I have read this".
  needsAck      Boolean   @default(false) @map("needs_ack")
  attachmentIds String[]  @default([]) @map("attachment_ids") @db.Uuid
  /// Posted from an event.
  eventId       String?   @map("event_id") @db.Uuid
  submittedBy   String?   @map("submitted_by") @db.Uuid
  publishedBy   String?   @map("published_by") @db.Uuid
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  isDemo        Boolean   @default(false) @map("is_demo")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reads  NoticeRead[]

  @@unique([id, tenantId])
  @@index([tenantId, status, publishAt])
  @@map("notices")
}

/// Who opened a notice (and acknowledged it).
model NoticeRead {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  noticeId       String    @map("notice_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  readAt         DateTime  @default(now()) @map("read_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([tenantId, userId])
  @@map("notice_reads")
}

/// Something on the school calendar: PTM, sports day, exams, a trip…
model SchoolEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  title         String
  /// Master "event_type" (PTM, Sports Day…).
  typeId        String?  @map("type_id") @db.Uuid
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  /// "09:30"; empty = all day.
  startTime     String?  @map("start_time")
  endTime       String?  @map("end_time")
  venue         String?
  description   String?
  /// Who it is for (any of these). Students / parents: the whole school, or only these classes / sections.
  forEveryone   Boolean  @default(false) @map("for_everyone")
  forAllStaff   Boolean  @default(false) @map("for_all_staff")
  roleIds       String[] @default([]) @map("role_ids") @db.Uuid
  forStudents   Boolean  @default(false) @map("for_students")
  forParents    Boolean  @default(false) @map("for_parents")
  classIds      String[] @default([]) @map("class_ids") @db.Uuid
  sectionIds    String[] @default([]) @map("section_ids") @db.Uuid
  /// none | students | staff | both: its days are holidays for them.
  holidayFor    String   @default("none") @map("holiday_for")
  attachmentIds String[] @default([]) @map("attachment_ids") @db.Uuid
  /// scheduled | cancelled
  status        String   @default("scheduled")
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate])
  @@map("school_events")
}

// ─── Dashboard ───────────────────────────────────────────────────────────────

/// A role's dashboard: which widgets, in what order and size (no row = the built-in layout for the role).
model DashboardLayout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  /// [{ "key": "fee_today", "size": "sm" }, …]
  widgets   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId])
  @@map("dashboard_layouts")
}

/// The classes a session runs (Bal Vatika may stop one year): the class list is the school's
/// catalogue; each session picks from it. Past sessions keep theirs.
model YearClass {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  /// New admissions (enquiries, the online form) are taken for it.
  admissionsOpen Boolean  @default(true) @map("admissions_open")
  /// Seats for new admissions this session (empty = no limit set).
  seats          Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Cascade)
  schoolClass  SchoolClass  @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([academicYearId, classId])
  @@index([tenantId, academicYearId])
  @@map("year_classes")
}

// ─── Promotion and transfer certificates ─────────────────────────────────────

/// What happened to a student at the end of a session: promoted, kept back, passed out or leaving.
/// Kept so a promotion can be undone (before the new session is used for them).
model StudentPromotion {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  studentId            String   @map("student_id") @db.Uuid
  fromYearId           String   @map("from_year_id") @db.Uuid
  toYearId             String?  @map("to_year_id") @db.Uuid
  fromSectionId        String   @map("from_section_id") @db.Uuid
  toSectionId          String?  @map("to_section_id") @db.Uuid
  /// promoted | detained | passed_out | leaving
  outcome              String
  /// Fee adjustments made to carry the old session's dues (removed on undo).
  carriedAdjustmentIds String[] @default([]) @map("carried_adjustment_ids") @db.Uuid
  carriedAmount        Int      @default(0) @map("carried_amount")
  isDemo               Boolean  @default(false) @map("is_demo")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?  @map("created_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([studentId, fromYearId])
  @@index([tenantId, fromYearId])
  @@map("student_promotions")
}

/// A transfer certificate: asked for, cleared (fees, library…), issued with a number, printed.
model TransferCertificate {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  /// requested | issued | cancelled
  status          String    @default("requested")
  tcNo            String?   @map("tc_no")
  applicationDate DateTime  @map("application_date") @db.Date
  leavingDate     DateTime  @map("leaving_date") @db.Date
  /// Master "leaving_reason".
  reasonId        String?   @map("reason_id") @db.Uuid
  /// "Class VII" (the class the student was in) and the result ("Passed and promoted to Class VIII").
  lastClass       String?   @map("last_class")
  result          String?
  conduct         String    @default("Good")
  remarks         String?
  /// [{ "id": master value, "label": "Library books returned", "done": true, "by": "…", "at": "…" }]
  clearances      Json      @default("[]")
  requestedBy     String?   @map("requested_by") @db.Uuid
  issuedBy        String?   @map("issued_by") @db.Uuid
  issuedAt        DateTime? @map("issued_at") @db.Timestamptz(6)
  /// Printed after the first time (marked "Duplicate").
  printCount      Int       @default(0) @map("print_count")
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelNote      String?   @map("cancel_note")
  isDemo          Boolean   @default(false) @map("is_demo")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?   @map("updated_by") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, tcNo])
  @@index([tenantId, status])
  @@map("transfer_certificates")
}

// ─── Exams ───────────────────────────────────────────────────────────────────

/// A grading scale: marks % → grade (CBSE 9-point), or descriptive grades (pre-primary, co-scholastic).
model GradeScale {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// marks: bands by % ({ grade, min, point, remark }); descriptive: grades chosen by the teacher ({ grade, remark }).
  kind      String   @default("marks")
  bands     Json     @default("[]")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("grade_scales")
}

/// How results are worked out for a class group (Primary, Middle…); the one without a group is for the rest.
model ResultRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// Master "class_group"; empty = every class not in a group with its own rule.
  classGroupId   String?  @map("class_group_id") @db.Uuid
  /// Subjects are graded (no marks), e.g. pre-primary.
  descriptive    Boolean  @default(false)
  gradeScaleId   String?  @map("grade_scale_id") @db.Uuid
  coScaleId      String?  @map("co_scale_id") @db.Uuid
  /// % needed to pass a subject.
  passPercent    Float    @default(33) @map("pass_percent")
  /// Each part (theory, practical…) must be passed on its own.
  passEachPart   Boolean  @default(false) @map("pass_each_part")
  /// Grace: up to this many marks, in at most this many subjects (0 = none).
  graceMarks     Int      @default(0) @map("grace_marks")
  graceSubjects  Int      @default(0) @map("grace_subjects")
  showRank       Boolean  @default(false) @map("show_rank")
  showAttendance Boolean  @default(true) @map("show_attendance")
  /// standard | cbse | cbse_senior | state | preprimary (which report card design)
  cardFormat     String   @default("standard") @map("card_format")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("result_rules")
}

/// A term of a session (Term 1, Term 2).
model ExamTerm {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String
  /// For the attendance shown on the term's report card.
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  sortOrder      Int       @default(0) @map("sort_order")
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exams  Exam[]

  @@unique([id, tenantId])
  @@index([tenantId, academicYearId])
  @@map("exam_terms")
}

/// An exam of a session (Periodic Test 1, Half-Yearly…) for some classes.
model Exam {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  academicYearId    String    @map("academic_year_id") @db.Uuid
  termId            String?   @map("term_id") @db.Uuid
  name              String
  shortName         String?   @map("short_name")
  sortOrder         Int       @default(0) @map("sort_order")
  classIds          String[]  @default([]) @map("class_ids") @db.Uuid
  /// The parts of each subject unless a subject says otherwise: [{ "key": "th", "label": "Theory", "max": 80 }, …]
  components        Json      @default("[]")
  /// Share of the term / final result (e.g. 10 for a periodic test, 30 for half-yearly).
  weightage         Float     @default(0)
  countsInResult    Boolean   @default(true) @map("counts_in_result")
  /// regular | supplementary (for students who failed in a few subjects of the final result)
  kind              String    @default("regular")
  /// Supplementary: { "<student id>": ["<subject id>", …] }
  candidates        Json      @default("{}")
  /// Students given their admit card although fees are due.
  admitReleased     String[]  @default([]) @map("admit_released") @db.Uuid
  /// draft | open (marks being entered) | locked | published
  status            String    @default("draft")
  entryDeadline     DateTime? @map("entry_deadline") @db.Date
  datesheetNoticeId String?   @map("datesheet_notice_id") @db.Uuid
  publishedAt       DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy       String?   @map("published_by") @db.Uuid
  isDemo            Boolean   @default(false) @map("is_demo")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?   @map("updated_by") @db.Uuid

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  term     ExamTerm?         @relation(fields: [termId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subjects ExamSubject[]
  notes    ExamStudentNote[]

  @@unique([id, tenantId])
  @@index([tenantId, academicYearId])
  @@map("exams")
}

/// A subject of an exam for a class: its parts and maximum marks, and its date on the date sheet.
model ExamSubject {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  examId        String    @map("exam_id") @db.Uuid
  classId       String    @map("class_id") @db.Uuid
  subjectId     String    @map("subject_id") @db.Uuid
  components    Json      @default("[]")
  date          DateTime? @db.Date
  startTime     String?   @map("start_time")
  endTime       String?   @map("end_time")
  room          String?
  invigilatorId String?   @map("invigilator_id") @db.Uuid
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam   Exam       @relation(fields: [examId, tenantId], references: [id, tenantId], onDelete: Cascade)
  marks  ExamMark[]

  @@unique([id, tenantId])
  @@unique([examId, classId, subjectId])
  @@map("exam_subjects")
}

/// A student's marks in an exam subject: per part, or a grade (descriptive); AB = absent, ML = medical, NA = not taking it.
model ExamMark {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  examSubjectId String   @map("exam_subject_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  /// { "th": 62, "pr": 18 } or { "grade": "A" }
  marks         Json     @default("{}")
  /// P | AB | ML | NA
  status        String   @default("P")
  total         Float?
  enteredBy     String?  @map("entered_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  examSubject ExamSubject @relation(fields: [examSubjectId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([examSubjectId, studentId])
  @@index([tenantId, studentId])
  @@map("exam_marks")
}

/// What the class teacher adds for a student in an exam: co-scholastic grades, discipline, remarks.
model ExamStudentNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  examId     String   @map("exam_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  /// { "<co-scholastic subject id>": "A" }
  coGrades   Json     @default("{}") @map("co_grades")
  discipline String?
  remark     String?
  enteredBy  String?  @map("entered_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam   Exam   @relation(fields: [examId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([examId, studentId])
  @@map("exam_student_notes")
}

/// A term's or the session's final result made visible to students and parents.
model ResultPublication {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  /// term | final
  scope          String
  termId         String?  @map("term_id") @db.Uuid
  publishedBy    String?  @map("published_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, academicYearId])
  @@map("result_publications")
}

// ─── Alerts & Messaging ──────────────────────────────────────────────────────

/// One in-app notification for one person (the bell).
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Notification type (Masters → Notification types, by code): attendance, fees, exams…
  type      String
  title     String
  body      String
  /// Screen it opens (e.g. /my-results).
  link      String?
  /// Priority (Masters → Priorities, by code): normal, important, emergency.
  priority  String    @default("normal")
  alertKey  String?   @map("alert_key")
  messageId String?   @map("message_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  isDemo    Boolean   @default(false) @map("is_demo")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

/// A message written on Messages → Compose (or one run of an alert): what was sent, to whom (described), how.
model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// compose | alert | custom
  kind           String    @default("compose")
  alertKey       String?   @map("alert_key")
  subject        String
  /// Email / in-app text; {{placeholders}} filled per person.
  body           String
  /// Short text for SMS / WhatsApp.
  shortText      String?   @map("short_text")
  /// in_app | email | sms | whatsapp
  channels       String[]  @default([])
  /// Master "message_category".
  categoryId     String?   @map("category_id") @db.Uuid
  priority       String    @default("normal")
  /// What was chosen on the To line (people, sections, roles, groups, addresses), for showing and resending.
  audience       Json      @default("{}")
  audienceLabel  String    @default("") @map("audience_label")
  cc             String[]  @default([])
  attachmentIds  String[]  @default([]) @map("attachment_ids") @db.Uuid
  /// An ERP document attached for each student (e.g. report_card) and its parameters.
  documentKey    String?   @map("document_key")
  documentParams Json?     @map("document_params")
  /// draft | scheduled | sending | sent | cancelled
  status         String    @default("draft")
  sendAt         DateTime? @map("send_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  recipients     Int       @default(0)
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries MessageDelivery[]

  @@index([tenantId, status, sendAt])
  @@index([tenantId, createdAt])
  @@map("messages")
}

/// One message to one person on one channel: the Alert Log. Email / SMS / WhatsApp wait here to be sent.
model MessageDelivery {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  messageId     String?   @map("message_id") @db.Uuid
  alertKey      String?   @map("alert_key")
  userId        String?   @map("user_id") @db.Uuid
  recipientName String    @map("recipient_name")
  /// staff | student | parent | other
  recipientKind String    @default("other") @map("recipient_kind")
  /// The email address or mobile number (none for in-app).
  address       String?
  /// in_app | email | sms | whatsapp
  channel       String
  /// queued | sending | sent | failed | skipped
  status        String    @default("queued")
  reason        String?
  subject       String
  body          String
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  /// Same alert, same person, same channel, same thing (e.g. absent:<student>:<day>) is sent once.
  dedupeKey     String?   @map("dedupe_key")
  /// Sections the message is about (for the log's Assigned scope).
  sectionIds    String[]  @default([]) @map("section_ids") @db.Uuid
  /// Uploaded files to attach, and an ERP document to render for this person ({ key, params }).
  attachmentIds String[]  @default([]) @map("attachment_ids") @db.Uuid
  document      Json?
  isDemo        Boolean   @default(false) @map("is_demo")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, messageId])
  @@index([tenantId, address])
  @@map("message_deliveries")
}

/// A school's choices for one built-in alert (defaults come from the code).
model AlertConfig {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String
  enabled    Boolean
  channels   String[] @default([])
  recipients String[] @default([])
  priority   String   @default("normal")
  /// People can't turn it off for themselves.
  required   Boolean  @default(false)
  subject    String?
  body       String?
  shortText  String?  @map("short_text")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("alert_configs")
}

/// A saved message for Compose ("School closed", "PTM invitation").
model MessageTemplate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  categoryId String?  @map("category_id") @db.Uuid
  subject    String
  body       String
  shortText  String?  @map("short_text")
  isDemo     Boolean  @default(false) @map("is_demo")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("message_templates")
}

/// The channels a person turned off for a notification type (My Profile → Notifications).
model NotificationPreference {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  /// Channels turned off: in_app, email, sms, whatsapp.
  muted     String[] @default([])
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, type])
  @@map("notification_preferences")
}

/// An alert the school made from a report: who (the report's rows), when, what.
model CustomAlert {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  name           String
  reportKey      String    @map("report_key")
  filters        Json      @default("{}")
  /// parent | student | staff | class_teacher | role:<id>
  sendTo         String[]  @default([]) @map("send_to")
  /// daily | weekly | monthly
  frequency      String    @default("weekly")
  /// weekly: 1 (Mon) … 7; monthly: 1 … 28.
  day            Int?
  /// "08:00" (school time).
  time           String    @default("08:00")
  channels       String[]  @default([])
  subject        String
  body           String
  shortText      String?   @map("short_text")
  /// Don't send to the same person again within these days.
  repeatDays     Int       @default(7) @map("repeat_days")
  /// To class teachers / a role: one list of the report's rows.
  summarySubject String    @default("{{alert}}: {{count}}") @map("summary_subject")
  summaryBody    String    @default("{{list}}") @map("summary_body")
  /// Notification type (Masters → Notification types) and priority.
  type           String    @default("messages")
  priority       String    @default("normal")
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at") @db.Timestamptz(6)
  lastResult     String?   @map("last_result")
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("custom_alerts")
}

/// A saved To line for Compose ("Sports team parents").
model RecipientGroup {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  audience  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("recipient_groups")
}

/// A scheduled job that ran for a school on a day (each runs once a day).
model JobRun {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  day       DateTime @db.Date
  result    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, day])
  @@map("job_runs")
}

// ─── Homework ────────────────────────────────────────────────────────────────

/// Homework given to one section in one subject (giving it to three sections makes three).
model Homework {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  sectionId      String    @map("section_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  /// Master "homework_type" (Homework, Classwork, Project…).
  typeId         String?   @map("type_id") @db.Uuid
  title          String
  details        String    @default("")
  attachmentIds  String[]  @default([]) @map("attachment_ids") @db.Uuid
  givenOn        DateTime  @map("given_on") @db.Date
  dueOn          DateTime  @map("due_on") @db.Date
  /// online (students submit) | class (the teacher ticks done / not done)
  mode           String    @default("online")
  /// draft | published
  status         String    @default("draft")
  /// Shown from (later = scheduled).
  publishAt      DateTime? @map("publish_at") @db.Timestamptz(6)
  /// Students and parents were told (the "new homework" alert).
  alertedAt      DateTime? @map("alerted_at") @db.Timestamptz(6)
  /// The teacher who gave it.
  staffId        String?   @map("staff_id") @db.Uuid
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@unique([id, tenantId])
  @@index([tenantId, sectionId, dueOn])
  @@index([tenantId, staffId, givenOn])
  @@map("homework")
}

/// A student's homework: what they handed in, and the teacher's check.
model HomeworkSubmission {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  homeworkId  String    @map("homework_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  /// submitted | late | done | not_done | checked | redo
  status      String
  answer      String?
  fileIds     String[]  @default([]) @map("file_ids") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  submittedBy String?   @map("submitted_by") @db.Uuid
  checkedAt   DateTime? @map("checked_at") @db.Timestamptz(6)
  checkedBy   String?   @map("checked_by") @db.Uuid
  /// Master "homework_grade" (Excellent, Good… Redo).
  gradeId     String?   @map("grade_id") @db.Uuid
  remark      String?
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([tenantId, studentId])
  @@map("homework_submissions")
}

// ─── Syllabus, question bank, AI ─────────────────────────────────────────────

/// A chapter of a class's subject (the syllabus), with its topics.
model Chapter {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  subjectId   String   @map("subject_id") @db.Uuid
  name        String
  topics      String[] @default([])
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classId, subjectId, name])
  @@index([tenantId, classId, subjectId])
  @@map("chapters")
}

/// A question of the question bank.
model Question {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  subjectId    String    @map("subject_id") @db.Uuid
  chapterId    String?   @map("chapter_id") @db.Uuid
  /// mcq (one answer) | multi (several) | true_false | fill | short | long
  type         String
  text         String
  imageFileId  String?   @map("image_file_id") @db.Uuid
  /// mcq / multi: [{ "text": "…", "correct": true }]
  options      Json      @default("[]")
  /// true_false: "true" / "false"; fill: the answer(s), "|" between accepted ones; short / long: a model answer.
  answer       String?
  explanation  String?
  marks        Float     @default(1)
  /// Masters "question_difficulty" and "question_level" (Bloom).
  difficultyId String?   @map("difficulty_id") @db.Uuid
  levelId      String?   @map("level_id") @db.Uuid
  /// draft | pending (waits for review) | approved | rejected
  status       String    @default("draft")
  /// manual | import | ai
  source       String    @default("manual")
  reviewNote   String?   @map("review_note")
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  isDemo       Boolean   @default(false) @map("is_demo")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    String?   @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, classId, subjectId, chapterId, status])
  @@map("questions")
}

/// One AI request: who, what for, how big (for limits and the usage screen).
model AiUsage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  /// generate_questions | suggest_chapters | test | tutor | quiz…
  feature   String
  provider  String
  model     String
  tokensIn  Int      @default(0) @map("tokens_in")
  tokensOut Int      @default(0) @map("tokens_out")
  ok        Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("ai_usage")
}

// ─── Online tests ────────────────────────────────────────────────────────────

/// An online test of a class's subject, for some of its sections, open in a time window.
model OnlineTest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  academicYearId   String    @map("academic_year_id") @db.Uuid
  classId          String    @map("class_id") @db.Uuid
  subjectId        String    @map("subject_id") @db.Uuid
  sectionIds       String[]  @default([]) @map("section_ids") @db.Uuid
  chapterIds       String[]  @default([]) @map("chapter_ids") @db.Uuid
  title            String
  instructions     String    @default("")
  durationMin      Int       @map("duration_min")
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime  @map("ends_at") @db.Timestamptz(6)
  shuffleQuestions Boolean   @default(true) @map("shuffle_questions")
  shuffleOptions   Boolean   @default(true) @map("shuffle_options")
  /// instant (when submitted) | after_review (when the teacher publishes)
  showResult       String    @default("after_review") @map("show_result")
  /// Marks taken off for a wrong objective answer.
  negativeMarks    Float     @default(0) @map("negative_marks")
  totalMarks       Float     @default(0) @map("total_marks")
  /// draft | published | results (results shown to students)
  status           String    @default("draft")
  resultsAt        DateTime? @map("results_at") @db.Timestamptz(6)
  alertedAt        DateTime? @map("alerted_at") @db.Timestamptz(6)
  staffId          String?   @map("staff_id") @db.Uuid
  isDemo           Boolean   @default(false) @map("is_demo")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?   @map("updated_by") @db.Uuid

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions OnlineTestQuestion[]
  attempts  TestAttempt[]

  @@unique([id, tenantId])
  @@index([tenantId, classId, subjectId])
  @@index([tenantId, startsAt])
  @@map("online_tests")
}

/// A question of a test: a copy of the bank's question as it was when added (later edits don't change the test).
model OnlineTestQuestion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  testId     String   @map("test_id") @db.Uuid
  questionId String?  @map("question_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  marks      Float
  /// { type, text, options, answer, explanation, imageFileId, chapterId }
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  test   OnlineTest @relation(fields: [testId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, testId])
  @@map("online_test_questions")
}

/// A student's go at a test: their answers, and the marks (automatic and the teacher's).
model TestAttempt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  testId      String    @map("test_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  /// When time runs out (the duration, or the end of the window if sooner).
  dueAt       DateTime  @map("due_at") @db.Timestamptz(6)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  /// in_progress | submitted (written answers to mark) | marked
  status      String    @default("in_progress")
  /// The student's order: { questions: [tqId…], options: { tqId: [original index…] } }
  layout      Json      @default("{}")
  /// { tqId: answer } (mcq: original choice index; multi: [indexes]; true_false: "true"/"false"; text otherwise)
  answers     Json      @default("{}")
  /// { tqId: { marks, by: "auto" | "teacher", note? } }
  marks       Json      @default("{}")
  score       Float?
  markedBy    String?   @map("marked_by") @db.Uuid
  markedAt    DateTime? @map("marked_at") @db.Timestamptz(6)
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  test   OnlineTest @relation(fields: [testId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([testId, studentId])
  @@index([tenantId, studentId])
  @@map("test_attempts")
}

// ─── AI learning ─────────────────────────────────────────────────────────────

/// A student's conversation with the AI tutor about a subject (and chapter).
model LearnChat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  classId   String   @map("class_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  chapterId String?  @map("chapter_id") @db.Uuid
  /// ask | explain | summary | points | questions
  mode      String   @default("ask")
  title     String
  messages  Int      @default(0)
  /// Some answer was refused as off-topic or unsafe (for the school to look at).
  flagged   Boolean  @default(false)
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  LearnMessage[]

  @@unique([id, tenantId])
  @@index([tenantId, studentId, updatedAt])
  @@map("learn_chats")
}

model LearnMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  /// user | assistant
  role      String
  text      String
  /// ok | off_topic | unsafe
  flag      String   @default("ok")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat   LearnChat @relation(fields: [chatId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, chatId, createdAt])
  @@map("learn_messages")
}

/// A practice quiz a student asked for: its questions (from the bank or the AI) and how they did.
model PracticeQuiz {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  classId     String    @map("class_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  chapterId   String?   @map("chapter_id") @db.Uuid
  /// bank | ai
  source      String
  /// [{ text, options: [{ text, correct }], explanation }]
  questions   Json
  answers     Json      @default("[]")
  score       Int?
  total       Int
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, createdAt])
  @@map("practice_quizzes")
}

// ─── Transport ───────────────────────────────────────────────────────────────

/// A school vehicle (bus, van…).
model Vehicle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// Registration number, e.g. UK07 PA 1234.
  number      String
  name        String
  /// Master "vehicle_type" (Bus, Mini bus, Van…).
  typeId      String?  @map("type_id") @db.Uuid
  capacity    Int      @default(40)
  make        String?
  model       String?
  year        Int?
  /// The GPS device's id at its provider (System Settings → Transport), if the vehicle has one.
  gpsDeviceId String?  @map("gps_device_id")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents VehicleDocument[]

  @@unique([id, tenantId])
  @@unique([tenantId, number])
  @@map("vehicles")
}

/// A vehicle's paper (fitness, insurance, permit, PUC…) and when it expires.
model VehicleDocument {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  vehicleId String    @map("vehicle_id") @db.Uuid
  /// Master "vehicle_document".
  typeId    String?   @map("type_id") @db.Uuid
  number    String?
  issuedOn  DateTime? @map("issued_on") @db.Date
  expiresOn DateTime? @map("expires_on") @db.Date
  fileId    String?   @map("file_id") @db.Uuid
  notes     String?
  isDemo    Boolean   @default(false) @map("is_demo")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, expiresOn])
  @@map("vehicle_documents")
}

/// A bus route: its vehicle, driver and helper, and its stops in order.
model TransportRoute {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  code           String?
  vehicleId      String?  @map("vehicle_id") @db.Uuid
  driverId       String?  @map("driver_id") @db.Uuid
  helperId       String?  @map("helper_id") @db.Uuid
  /// "07:00": when the morning trip leaves the first stop; the afternoon one leaves school.
  morningStart   String   @default("07:00") @map("morning_start")
  afternoonStart String   @default("14:00") @map("afternoon_start")
  /// The school (end of the morning trip, start of the afternoon one).
  schoolLat      Float?   @map("school_lat")
  schoolLng      Float?   @map("school_lng")
  color          String   @default("#1A365D")
  isActive       Boolean  @default(true) @map("is_active")
  isDemo         Boolean  @default(false) @map("is_demo")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops  TransportStop[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@map("transport_routes")
}

/// A stop of a route, in order, with its usual times and fare.
model TransportStop {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  routeId       String   @map("route_id") @db.Uuid
  name          String
  landmark      String?
  lat           Float?
  lng           Float?
  sortOrder     Int      @default(0) @map("sort_order")
  /// "07:25": when the morning bus is due here; the afternoon one.
  morningTime   String?  @map("morning_time")
  afternoonTime String?  @map("afternoon_time")
  /// Transport fee for each instalment, from this stop.
  fare          Int      @default(0)
  isActive      Boolean  @default(true) @map("is_active")
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route  TransportRoute @relation(fields: [routeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, routeId])
  @@map("transport_stops")
}

/// A student's transport in a session: route, stop, which way, from when (and their own fare, if set).
model StudentTransport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  routeId        String    @map("route_id") @db.Uuid
  stopId         String    @map("stop_id") @db.Uuid
  /// both | pickup (morning only) | drop (afternoon only)
  way            String    @default("both")
  fromDate       DateTime  @map("from_date") @db.Date
  toDate         DateTime? @map("to_date") @db.Date
  /// A fare of their own for each instalment (else the stop's).
  fare           Int?
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, academicYearId, studentId])
  @@index([tenantId, routeId])
  @@map("student_transport")
}

/// One run of a route (morning, afternoon or a special trip), tracked live.
model Trip {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  routeId   String    @map("route_id") @db.Uuid
  vehicleId String?   @map("vehicle_id") @db.Uuid
  /// Who runs it (the driver's or helper's login).
  userId    String?   @map("user_id") @db.Uuid
  /// morning | afternoon | special
  kind      String
  day       DateTime  @db.Date
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  /// running | done
  status    String    @default("running")
  /// phone | device | simulated
  source    String    @default("phone")
  lastLat   Float?    @map("last_lat")
  lastLng   Float?    @map("last_lng")
  lastSpeed Float?    @map("last_speed")
  lastAt    DateTime? @map("last_at") @db.Timestamptz(6)
  /// The next stop (index in the trip's order) and how late the bus is.
  nextStop  Int       @default(0) @map("next_stop")
  delayMin  Int       @default(0) @map("delay_min")
  isDemo    Boolean   @default(false) @map("is_demo")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  points TripPoint[]
  events TripEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, day, status])
  @@index([tenantId, routeId, day])
  @@map("trips")
}

/// A position sent during a trip.
model TripPoint {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  tripId   String   @map("trip_id") @db.Uuid
  lat      Float
  lng      Float
  /// km/h
  speed    Float?
  accuracy Float?
  at       DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, tripId, at])
  @@map("trip_points")
}

/// What happened on a trip: started, reached a stop, boarded / dropped, SOS, overspeed, late, ended.
model TripEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  /// start | stop | boarded | dropped | absent | sos | overspeed | late | end
  kind      String
  stopId    String?  @map("stop_id") @db.Uuid
  studentId String?  @map("student_id") @db.Uuid
  note      String?
  lat       Float?
  lng       Float?
  userId    String?  @map("user_id") @db.Uuid
  at        DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, tripId, at])
  @@index([tenantId, studentId, at])
  @@map("trip_events")
}

/// A title in the library (book, magazine, reference, e-book…); its physical copies are BookCopy.
model Book {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String
  subtitle    String?
  /// "R. K. Narayan, …"
  authors     String?
  publisher   String?
  edition     String?
  year        Int?
  isbn        String?
  /// book | reference | magazine | newspaper | cd | ebook
  kind        String   @default("book")
  /// Masters "library_category", "library_language", "library_location".
  categoryId  String?  @map("category_id") @db.Uuid
  languageId  String?  @map("language_id") @db.Uuid
  locationId  String?  @map("location_id") @db.Uuid
  /// Shelf mark / call number, e.g. 823 NAR.
  callNumber  String?  @map("call_number")
  /// For whom, e.g. "Class VI–VIII".
  level       String?
  price       Int?
  pages       Int?
  keywords    String?
  coverFileId String?  @map("cover_file_id") @db.Uuid
  /// An e-book: its file, or a link.
  fileId      String?  @map("file_id") @db.Uuid
  link        String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copies BookCopy[]

  @@unique([id, tenantId])
  @@index([tenantId, title])
  @@index([tenantId, isbn])
  @@map("books")
}

/// A physical copy, with its accession number (the barcode on it).
model BookCopy {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  bookId      String    @map("book_id") @db.Uuid
  accessionNo String    @map("accession_no")
  /// available | issued | on_hold (kept for a reservation) | lost | damaged | withdrawn
  status      String    @default("available")
  /// Master "book_condition".
  conditionId String?   @map("condition_id") @db.Uuid
  locationId  String?   @map("location_id") @db.Uuid
  acquiredOn  DateTime? @map("acquired_on") @db.Date
  /// purchase | donation | other
  source      String?
  billNo      String?   @map("bill_no")
  price       Int?
  notes       String?
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  book   Book          @relation(fields: [bookId, tenantId], references: [id, tenantId], onDelete: Cascade)
  loans  LibraryLoan[]

  @@unique([id, tenantId])
  @@unique([tenantId, accessionNo])
  @@index([tenantId, bookId])
  @@map("book_copies")
}

/// A copy lent to a student or a staff member.
model LibraryLoan {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  copyId     String    @map("copy_id") @db.Uuid
  bookId     String    @map("book_id") @db.Uuid
  /// student | staff
  memberKind String    @map("member_kind")
  studentId  String?   @map("student_id") @db.Uuid
  staffId    String?   @map("staff_id") @db.Uuid
  issuedOn   DateTime  @map("issued_on") @db.Date
  dueOn      DateTime  @map("due_on") @db.Date
  returnedOn DateTime? @map("returned_on") @db.Date
  renewals   Int       @default(0)
  /// out | returned | lost
  status     String    @default("out")
  issuedBy   String?   @map("issued_by") @db.Uuid
  returnedBy String?   @map("returned_by") @db.Uuid
  /// When the overdue alert was last sent.
  remindedOn DateTime? @map("reminded_on") @db.Date
  note       String?
  isDemo     Boolean   @default(false) @map("is_demo")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  copy   BookCopy @relation(fields: [copyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, status, dueOn])
  @@index([tenantId, studentId])
  @@index([tenantId, staffId])
  @@index([tenantId, bookId])
  @@map("library_loans")
}

/// A member waiting for a title; when a copy comes back it is kept for them (ready) for some days.
model LibraryReservation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  bookId     String    @map("book_id") @db.Uuid
  memberKind String    @map("member_kind")
  studentId  String?   @map("student_id") @db.Uuid
  staffId    String?   @map("staff_id") @db.Uuid
  /// waiting | ready | issued | cancelled | expired
  status     String    @default("waiting")
  copyId     String?   @map("copy_id") @db.Uuid
  readyAt    DateTime? @map("ready_at") @db.Timestamptz(6)
  holdUntil  DateTime? @map("hold_until") @db.Date
  createdBy  String?   @map("created_by") @db.Uuid
  isDemo     Boolean   @default(false) @map("is_demo")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, bookId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, staffId])
  @@map("library_reservations")
}

/// A fine: late return, lost or damaged book. Students' fines go into their fees (System Settings → Library).
model LibraryFine {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  loanId         String?   @map("loan_id") @db.Uuid
  memberKind     String    @map("member_kind")
  studentId      String?   @map("student_id") @db.Uuid
  staffId        String?   @map("staff_id") @db.Uuid
  academicYearId String?   @map("academic_year_id") @db.Uuid
  /// late | lost | damaged
  kind           String
  amount         Int
  waived         Int       @default(0)
  waiveReason    String?   @map("waive_reason")
  waivedBy       String?   @map("waived_by") @db.Uuid
  /// fees: added to the student's fees · counter: paid at the library
  payAt          String    @default("fees") @map("pay_at")
  /// due | paid | waived (counter fines; fee fines are paid with the fees)
  status         String    @default("due")
  paidOn         DateTime? @map("paid_on") @db.Date
  receivedBy     String?   @map("received_by") @db.Uuid
  receiptNo      String?   @map("receipt_no")
  on             DateTime  @db.Date
  note           String?
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([tenantId, academicYearId, payAt])
  @@map("library_fines")
}

/// A stock check: copies scanned on the shelves; the rest are missing.
model LibraryStockCheck {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  /// open | closed
  status    String    @default("open")
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  isDemo    Boolean   @default(false) @map("is_demo")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scans  LibraryStockScan[]

  @@unique([id, tenantId])
  @@map("library_stock_checks")
}

/// A copy found on the shelves during a stock check.
model LibraryStockScan {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  checkId  String   @map("check_id") @db.Uuid
  copyId   String   @map("copy_id") @db.Uuid
  at       DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  check  LibraryStockCheck @relation(fields: [checkId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([checkId, copyId])
  @@map("library_stock_scans")
}

/// A parent–teacher meeting day: which sections, the time window and slot length, who sits.
model Ptm {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  title          String
  date           DateTime  @db.Date
  /// "09:00" – "13:00", school time.
  startTime      String    @map("start_time")
  endTime        String    @map("end_time")
  slotMinutes    Int       @default(10) @map("slot_minutes")
  /// A break with no slots, e.g. "11:00" – "11:20".
  breakStart     String?   @map("break_start")
  breakEnd       String?   @map("break_end")
  /// in_person | online | both
  mode           String    @default("in_person")
  /// class: the class teacher only · class_subject: and the subject teachers
  whoSits        String    @default("class_subject") @map("who_sits")
  /// Parents book slots (else walk-in only).
  booking        Boolean   @default(true)
  sectionIds     String[]  @map("section_ids") @db.Uuid
  /// draft | published | done | cancelled
  status         String    @default("draft")
  note           String?
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachers PtmTeacher[]
  meetings PtmMeeting[]

  @@unique([id, tenantId])
  @@index([tenantId, date])
  @@map("ptms")
}

/// A teacher sitting at a PTM: their room or video link, or away that day.
model PtmTeacher {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  ptmId    String  @map("ptm_id") @db.Uuid
  staffId  String  @map("staff_id") @db.Uuid
  room     String?
  link     String?
  away     Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ptm    Ptm    @relation(fields: [ptmId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([ptmId, staffId])
  @@map("ptm_teachers")
}

/// A parent meeting a teacher about a student: the booked slot (or walk-in), and the outcome.
model PtmMeeting {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  ptmId       String    @map("ptm_id") @db.Uuid
  staffId     String    @map("staff_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  /// "09:20"; null for a walk-in.
  slot        String?
  /// Master "ptm_topic" ids the parent picked, and their note.
  topicIds    String[]  @map("topic_ids") @db.Uuid
  parentNote  String?   @map("parent_note")
  /// booked | waiting (checked in at the desk) | attended | absent | cancelled
  status      String    @default("booked")
  bookedBy    String?   @map("booked_by") @db.Uuid
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(6)
  metAt       DateTime? @map("met_at") @db.Timestamptz(6)
  /// Master "ptm_remark" points, the teacher's words, action points and a follow-up date.
  remarkIds   String[]  @map("remark_ids") @db.Uuid
  remarks     String?
  actions     String?
  followUpOn  DateTime? @map("follow_up_on") @db.Date
  /// Parents see the remarks (System Settings → PTM decides the default).
  shared      Boolean   @default(true)
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ptm    Ptm    @relation(fields: [ptmId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([ptmId, staffId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, ptmId, staffId])
  @@map("ptm_meetings")
}

/// A person who has visited the school (found again by their mobile number).
model Visitor {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  mobile          String?
  photoFileId     String?   @map("photo_file_id") @db.Uuid
  /// Master "visitor_id_type" (Aadhaar, Driving licence…), and its number.
  idTypeId        String?   @map("id_type_id") @db.Uuid
  idNumber        String?   @map("id_number")
  address         String?
  blacklisted     Boolean   @default(false)
  blacklistReason String?   @map("blacklist_reason")
  lastVisitAt     DateTime? @map("last_visit_at") @db.Timestamptz(6)
  isDemo          Boolean   @default(false) @map("is_demo")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits Visit[]

  @@unique([id, tenantId])
  @@index([tenantId, mobile])
  @@map("visitors")
}

/// One visit: whom they came to meet, the pass, in and out (or expected, waiting for approval, turned away).
model Visit {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  visitorId    String    @map("visitor_id") @db.Uuid
  passNo       String?   @map("pass_no")
  day          DateTime  @db.Date
  /// Master "visit_purpose".
  purposeId    String?   @map("purpose_id") @db.Uuid
  /// staff | student (a student's parent / relative) | office
  hostKind     String    @default("office") @map("host_kind")
  staffId      String?   @map("staff_id") @db.Uuid
  studentId    String?   @map("student_id") @db.Uuid
  people       Int       @default(1)
  vehicleNo    String?   @map("vehicle_no")
  note         String?
  photoFileId  String?   @map("photo_file_id") @db.Uuid
  /// expected | waiting (host to approve) | in | out | denied | no_show
  status       String    @default("in")
  inAt         DateTime? @map("in_at") @db.Timestamptz(6)
  outAt        DateTime? @map("out_at") @db.Timestamptz(6)
  answeredBy   String?   @map("answered_by") @db.Uuid
  answeredAt   DateTime? @map("answered_at") @db.Timestamptz(6)
  answerNote   String?   @map("answer_note")
  createdBy    String?   @map("created_by") @db.Uuid
  checkedOutBy String?   @map("checked_out_by") @db.Uuid
  isDemo       Boolean   @default(false) @map("is_demo")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitor Visitor @relation(fields: [visitorId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, day, status])
  @@index([tenantId, staffId])
  @@index([tenantId, passNo])
  @@map("visits")
}

/// Someone besides the parents (from the family record) who may collect a student.
model PickupPerson {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  name        String
  /// Master "pickup_relation" (Uncle, Grandfather, Driver…).
  relationId  String?  @map("relation_id") @db.Uuid
  mobile      String?
  photoFileId String?  @map("photo_file_id") @db.Uuid
  note        String?
  isActive    Boolean  @default(true) @map("is_active")
  addedBy     String?  @map("added_by") @db.Uuid
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("pickup_people")
}

/// A student collected early (during school hours): by whom, why, and whether they were on the list.
model StudentPickup {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  /// guardian (family record) | person (pickup list) | other (not on the list)
  byKind      String    @map("by_kind")
  guardianId  String?   @map("guardian_id") @db.Uuid
  personId    String?   @map("person_id") @db.Uuid
  name        String
  relation    String?
  mobile      String?
  photoFileId String?   @map("photo_file_id") @db.Uuid
  reason      String?
  /// done | waiting (office to approve: not on the list) | refused
  status      String    @default("done")
  at          DateTime  @default(now()) @db.Timestamptz(6)
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  isDemo      Boolean   @default(false) @map("is_demo")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, at])
  @@index([tenantId, studentId])
  @@map("student_pickups")
}

/// A complaint or grievance: who raised it (or anonymous), about what, who handles it, and where it stands.
model Complaint {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  ticketNo        String    @map("ticket_no")
  /// Master "complaint_category".
  categoryId      String?   @map("category_id") @db.Uuid
  subject         String
  details         String
  /// normal | high | urgent
  priority        String    @default("normal")
  /// new | assigned | in_progress | resolved | closed | reopened
  status          String    @default("new")
  anonymous       Boolean   @default(false)
  /// Who raised it (their login), and as what: parent | student | staff | office (for a walk-in / phone call)
  raisedBy        String?   @map("raised_by") @db.Uuid
  raisedAs        String    @default("parent") @map("raised_as")
  /// A complaint taken at the office for someone without a login.
  contactName     String?   @map("contact_name")
  contactMobile   String?   @map("contact_mobile")
  /// What it is about (optional).
  studentId       String?   @map("student_id") @db.Uuid
  staffId         String?   @map("staff_id") @db.Uuid
  routeId         String?   @map("route_id") @db.Uuid
  /// The handler (a login) and since when.
  assignedTo      String?   @map("assigned_to") @db.Uuid
  assignedAt      DateTime? @map("assigned_at") @db.Timestamptz(6)
  firstResponseAt DateTime? @map("first_response_at") @db.Timestamptz(6)
  respondBy       DateTime? @map("respond_by") @db.Timestamptz(6)
  resolveBy       DateTime? @map("resolve_by") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  resolution      String?
  /// 0 = not escalated; 1, 2… each time it went over its time.
  escalation      Int       @default(0)
  escalatedAt     DateTime? @map("escalated_at") @db.Timestamptz(6)
  reopened        Int       @default(0)
  rating          Int?
  ratingNote      String?   @map("rating_note")
  attachmentIds   String[]  @map("attachment_ids") @db.Uuid
  isDemo          Boolean   @default(false) @map("is_demo")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages ComplaintMessage[]

  @@unique([id, tenantId])
  @@unique([tenantId, ticketNo])
  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@index([tenantId, raisedBy])
  @@map("complaints")
}

/// The thread: replies (the complainant sees), internal notes (staff only) and events (assigned, resolved…).
model ComplaintMessage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  complaintId   String   @map("complaint_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  authorName    String   @map("author_name")
  /// reply | note | event
  kind          String   @default("reply")
  /// The complainant wrote it (else the school).
  fromRaiser    Boolean  @default(false) @map("from_raiser")
  text          String
  attachmentIds String[] @map("attachment_ids") @db.Uuid
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  complaint Complaint @relation(fields: [complaintId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, complaintId, createdAt])
  @@map("complaint_messages")
}

/// A discipline incident (or a positive note): what happened, where, how serious, and whether it is settled.
model Incident {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  /// Master "incident_type" (late coming, fight… or a positive one).
  typeId         String?   @map("type_id") @db.Uuid
  positive       Boolean   @default(false)
  /// minor | moderate | serious (positive notes: minor)
  severity       String    @default("minor")
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(6)
  /// Master "incident_place".
  placeId        String?   @map("place_id") @db.Uuid
  title          String
  details        String?
  attachmentIds  String[]  @map("attachment_ids") @db.Uuid
  /// open | resolved
  status         String    @default("open")
  followUpOn     DateTime? @map("follow_up_on") @db.Date
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  recordedBy     String?   @map("recorded_by") @db.Uuid
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students IncidentStudent[]
  actions  IncidentAction[]

  @@unique([id, tenantId])
  @@index([tenantId, occurredAt])
  @@map("incidents")
}

/// A student in an incident: their part, points, and whether the parents were told and acknowledged.
model IncidentStudent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  incidentId     String    @map("incident_id") @db.Uuid
  studentId      String    @map("student_id") @db.Uuid
  sectionId      String?   @map("section_id") @db.Uuid
  /// did | affected | witness (positive notes: did)
  role           String    @default("did")
  /// Merit (+) / demerit (−) points, from the type (System Settings → Discipline).
  points         Int       @default(0)
  /// none | alert | phone | meeting
  informedHow    String    @default("none") @map("informed_how")
  informedAt     DateTime? @map("informed_at") @db.Timestamptz(6)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  parentReply    String?   @map("parent_reply")
  isDemo         Boolean   @default(false) @map("is_demo")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident Incident @relation(fields: [incidentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([incidentId, studentId])
  @@index([tenantId, studentId])
  @@map("incident_students")
}

/// An action taken (warning, detention, suspension…), for one student or all; some wait for approval.
model IncidentAction {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  incidentId String    @map("incident_id") @db.Uuid
  studentId  String?   @map("student_id") @db.Uuid
  /// Master "discipline_action".
  actionId   String?   @map("action_id") @db.Uuid
  note       String?
  fromDate   DateTime? @map("from_date") @db.Date
  toDate     DateTime? @map("to_date") @db.Date
  /// done | pending (waiting for approval) | rejected
  status     String    @default("done")
  decidedBy  String?   @map("decided_by") @db.Uuid
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  answer     String?
  isDemo     Boolean   @default(false) @map("is_demo")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incident Incident @relation(fields: [incidentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("incident_actions")
}

/// A feedback question set (rating, yes / no and comment questions), for students, parents or both.
model FeedbackForm {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  /// student | parent | both
  audience  String   @default("student")
  /// [{ id, kind: rating | yesno | text, text, required }]
  questions Json
  isActive  Boolean  @default(true) @map("is_active")
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rounds FeedbackRound[]

  @@unique([id, tenantId])
  @@map("feedback_forms")
}

/// A feedback round: a question set, some sections, open between two dates; results released to teachers after.
model FeedbackRound {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  formId         String    @map("form_id") @db.Uuid
  name           String
  /// student | parent | both
  audience       String    @default("student")
  sectionIds     String[]  @map("section_ids") @db.Uuid
  anonymous      Boolean   @default(true)
  /// Students / parents with forms left can't use the rest of the app until they finish.
  mustFill       Boolean   @default(false) @map("must_fill")
  opensOn        DateTime  @map("opens_on") @db.Date
  closesOn       DateTime  @map("closes_on") @db.Date
  /// draft | open | closed | released (teachers can see their results)
  status         String    @default("draft")
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  isDemo         Boolean   @default(false) @map("is_demo")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form        FeedbackForm         @relation(fields: [formId, tenantId], references: [id, tenantId], onDelete: Restrict)
  responses   FeedbackResponse[]
  completions FeedbackCompletion[]

  @@unique([id, tenantId])
  @@map("feedback_rounds")
}

/// One filled form about one teacher (not linked to the person when the round is anonymous).
model FeedbackResponse {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  roundId        String   @map("round_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  /// student | parent
  respondentKind String   @map("respondent_kind")
  /// Only when the round isn't anonymous.
  userId         String?  @map("user_id") @db.Uuid
  studentId      String?  @map("student_id") @db.Uuid
  /// { questionId: 1–5 | true / false | text }
  answers        Json
  comment        String?
  /// shown | pending (to be screened) | hidden
  commentStatus  String   @default("shown") @map("comment_status")
  isDemo         Boolean  @default(false) @map("is_demo")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  round  FeedbackRound @relation(fields: [roundId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, roundId, staffId])
  @@map("feedback_responses")
}

/// Who has filled which teacher's form (to stop doubles and to remind), kept apart from the answers.
model FeedbackCompletion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  at        DateTime @default(now()) @db.Timestamptz(6)
  isDemo    Boolean  @default(false) @map("is_demo")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  round  FeedbackRound @relation(fields: [roundId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([roundId, userId, studentId, staffId])
  @@map("feedback_completions")
}

/// A folder of shared files, with who can see what is in it (or the same as its parent).
model UploadFolder {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  description String?
  /// Who can see it: the same as the parent folder (inherit), everyone, staff, or the lists below.
  inherit     Boolean  @default(true)
  /// everyone | staff | custom
  audience    String   @default("everyone")
  roleSlugs   String[] @map("role_slugs")
  sectionIds  String[] @map("section_ids") @db.Uuid
  userIds     String[] @map("user_ids") @db.Uuid
  /// With sections: their parents see it too.
  withParents Boolean  @default(true) @map("with_parents")
  /// Teachers can add files here (for the sections they teach).
  staffAdd    Boolean  @default(false) @map("staff_add")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  UploadItem[]

  @@unique([id, tenantId])
  @@index([tenantId, parentId])
  @@map("upload_folders")
}

/// A shared file (or link) in a folder: its current version, who sees it, until when, and whether it must be acknowledged.
model UploadItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  folderId    String    @map("folder_id") @db.Uuid
  title       String
  description String?
  /// Master "upload_tag".
  tagIds      String[]  @map("tag_ids") @db.Uuid
  /// file | link
  kind        String    @default("file")
  fileId      String?   @map("file_id") @db.Uuid
  link        String?
  fileName    String?   @map("file_name")
  mimeType    String?   @map("mime_type")
  sizeBytes   Int?      @map("size_bytes")
  version     Int       @default(1)
  inherit     Boolean   @default(true)
  audience    String    @default("everyone")
  roleSlugs   String[]  @map("role_slugs")
  sectionIds  String[]  @map("section_ids") @db.Uuid
  userIds     String[]  @map("user_ids") @db.Uuid
  withParents Boolean   @default(true) @map("with_parents")
  validUntil  DateTime? @map("valid_until") @db.Date
  needsAck    Boolean   @default(false) @map("needs_ack")
  /// published | pending (waiting for approval)
  status      String    @default("published")
  uploadedBy  String?   @map("uploaded_by") @db.Uuid
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder   UploadFolder    @relation(fields: [folderId, tenantId], references: [id, tenantId], onDelete: Cascade)
  versions UploadVersion[]
  views    UploadView[]

  @@unique([id, tenantId])
  @@index([tenantId, folderId])
  @@map("upload_items")
}

/// Earlier versions of a file.
model UploadVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  version    Int
  fileId     String?  @map("file_id") @db.Uuid
  link       String?
  fileName   String?  @map("file_name")
  uploadedBy String?  @map("uploaded_by") @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   UploadItem @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, itemId])
  @@map("upload_versions")
}

/// Who opened / downloaded a file, and acknowledged it.
model UploadView {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  itemId         String    @map("item_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  firstAt        DateTime  @default(now()) @map("first_at") @db.Timestamptz(6)
  lastAt         DateTime  @default(now()) @map("last_at") @db.Timestamptz(6)
  opens          Int       @default(1)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  remindedAt     DateTime? @map("reminded_at") @db.Timestamptz(6)
  isDemo         Boolean   @default(false) @map("is_demo")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   UploadItem @relation(fields: [itemId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([itemId, userId])
  @@map("upload_views")
}

/// An asset of the school (or a group of the same items, with a quantity): where it is, who has it, its value and care.
model Asset {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  code              String
  name              String
  /// Masters "asset_category", "asset_condition", "asset_vendor", "room".
  categoryId        String?   @map("category_id") @db.Uuid
  conditionId       String?   @map("condition_id") @db.Uuid
  vendorId          String?   @map("vendor_id") @db.Uuid
  roomId            String?   @map("room_id") @db.Uuid
  /// The staff member it is given to (a laptop…), if any.
  staffId           String?   @map("staff_id") @db.Uuid
  make              String?
  model             String?
  serialNo          String?   @map("serial_no")
  quantity          Int       @default(1)
  purchasedOn       DateTime? @map("purchased_on") @db.Date
  billNo            String?   @map("bill_no")
  /// Cost of the whole entry (all its quantity), in rupees.
  cost              Int?
  warrantyUntil     DateTime? @map("warranty_until") @db.Date
  amcUntil          DateTime? @map("amc_until") @db.Date
  /// Maintenance every N months (0 / empty = none) and when it is next due.
  maintainEvery     Int?      @map("maintain_every")
  nextMaintenanceOn DateTime? @map("next_maintenance_on") @db.Date
  photoFileId       String?   @map("photo_file_id") @db.Uuid
  billFileId        String?   @map("bill_file_id") @db.Uuid
  /// in_use | in_repair | disposed | lost
  status            String    @default("in_use")
  disposedOn        DateTime? @map("disposed_on") @db.Date
  notes             String?
  isDemo            Boolean   @default(false) @map("is_demo")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  history   AssetEvent[]
  issues    AssetIssue[]
  disposals AssetDisposal[]

  @@unique([id, tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, roomId])
  @@index([tenantId, staffId])
  @@map("assets")
}

/// What happened to an asset: moved, given / taken back, condition changed, maintained, disposed.
model AssetEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  /// added | moved | assigned | returned | condition | maintained | repaired | disposed | verified
  kind        String
  fromRoomId  String?  @map("from_room_id") @db.Uuid
  toRoomId    String?  @map("to_room_id") @db.Uuid
  fromStaffId String?  @map("from_staff_id") @db.Uuid
  toStaffId   String?  @map("to_staff_id") @db.Uuid
  cost        Int?
  note        String?
  userId      String?  @map("user_id") @db.Uuid
  at          DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, assetId, at])
  @@map("asset_events")
}

/// A problem reported with an asset, and its repair.
model AssetIssue {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  title       String
  details     String?
  photoFileId String?   @map("photo_file_id") @db.Uuid
  reportedBy  String?   @map("reported_by") @db.Uuid
  /// open | in_repair | fixed | written_off
  status      String    @default("open")
  assignedTo  String?   @map("assigned_to") @db.Uuid
  vendorId    String?   @map("vendor_id") @db.Uuid
  cost        Int?
  resolution  String?
  fixedAt     DateTime? @map("fixed_at") @db.Timestamptz(6)
  isDemo      Boolean   @default(false) @map("is_demo")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("asset_issues")
}

/// A request to write an asset off (sold, scrapped, lost, donated), approved or refused.
model AssetDisposal {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  assetId    String    @map("asset_id") @db.Uuid
  /// sold | scrapped | lost | donated
  reason     String
  note       String?
  amount     Int?
  /// pending | approved | rejected
  status     String    @default("pending")
  askedBy    String?   @map("asked_by") @db.Uuid
  answeredBy String?   @map("answered_by") @db.Uuid
  answeredAt DateTime? @map("answered_at") @db.Timestamptz(6)
  isDemo     Boolean   @default(false) @map("is_demo")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("asset_disposals")
}

/// A physical verification: assets found (scanned / ticked) room by room; the rest are missing.
model AssetVerification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  /// open | closed
  status    String    @default("open")
  createdBy String?   @map("created_by") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)
  isDemo    Boolean   @default(false) @map("is_demo")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  found  AssetFound[]

  @@unique([id, tenantId])
  @@map("asset_verifications")
}

model AssetFound {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  verificationId String   @map("verification_id") @db.Uuid
  assetId        String   @map("asset_id") @db.Uuid
  /// The room it was found in (different from the register = misplaced).
  roomId         String?  @map("room_id") @db.Uuid
  at             DateTime @default(now()) @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verification AssetVerification @relation(fields: [verificationId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([verificationId, assetId])
  @@map("asset_verification_found")
}

/// An ID card design: who it is for, the fields on the front and back, colours and the code printed.
model IdCardDesign {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  /// student | staff
  kind            String
  /// portrait | landscape
  orientation     String   @default("portrait")
  /// Header colour (#RRGGBB) and the text on it.
  color           String   @default("#1A365D")
  textColor       String   @default("#FFFFFF") @map("text_color")
  /// Field keys on the front, in order (photo, name, class, admissionNo…).
  fields          String[] @default([])
  /// qr | barcode | none (of the card number)
  code            String   @default("qr")
  /// A back side, its fields and free text ("If found, please return…").
  back            Boolean  @default(true)
  backFields      String[] @default([]) @map("back_fields")
  backText        String?  @map("back_text")
  signatureFileId String?  @map("signature_file_id") @db.Uuid
  signatureLabel  String?  @map("signature_label")
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  isDemo          Boolean  @default(false) @map("is_demo")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cards  IdCard[]

  @@unique([id, tenantId])
  @@map("id_card_designs")
}

/// A card given to a student or staff member; a duplicate replaces the previous card.
model IdCard {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  cardNo         String    @map("card_no")
  designId       String?   @map("design_id") @db.Uuid
  /// student | staff
  holderType     String    @map("holder_type")
