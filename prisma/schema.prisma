}

/// A staff member's pay for a month: days, earnings, deductions, employer contributions, net.
model Payslip {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  totalDays  Float    @map("total_days")
  paidDays   Float    @map("paid_days")
  /// { present, paidLeave, lwp, absent, lates, latePenalty, notJoined }
  days       Json     @default("{}")
  /// [{ "code": "BASIC", "name": "Basic", "full": 30000, "amount": 29000 }]
  earnings   Json     @default("[]")
  deductions Json     @default("[]")
  /// { "pf": 1800, "esi": 0 }
  employer   Json     @default("{}")
  gross      Float
  deducted   Float
  net        Float
