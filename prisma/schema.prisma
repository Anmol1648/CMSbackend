  incidents        Incident[]
  incidentStudents IncidentStudent[]
  incidentActions  IncidentAction[]

  feedbackForms       FeedbackForm[]
  feedbackRounds      FeedbackRound[]
  feedbackResponses   FeedbackResponse[]
  feedbackCompletions FeedbackCompletion[]

  uploadFolders  UploadFolder[]
  uploadItems    UploadItem[]
  uploadVersions UploadVersion[]
  uploadViews    UploadView[]

  assets             Asset[]
  assetEvents        AssetEvent[]
  assetIssues        AssetIssue[]
  assetDisposals     AssetDisposal[]
  assetVerifications AssetVerification[]
  assetFound         AssetFound[]

  idCardDesigns   IdCardDesign[]
  idCards         IdCard[]
  idPhotoRequests IdPhotoRequest[]

  invItems          InvItem[]
  invStock          InvStock[]
  invBatches        InvBatch[]
  invMoves          InvMove[]
  invRequests       InvRequest[]
  invRequestLines   InvRequestLine[]
  invPurchaseOrders InvPurchaseOrder[]
  invPoLines        InvPoLine[]
  invReceipts       InvReceipt[]
  invReceiptLines   InvReceiptLine[]
  invAdjustments    InvAdjustment[]
  invCounts         InvCount[]
  invCountLines     InvCountLine[]
  invSales          InvSale[]
  invSaleLines      InvSaleLine[]

  examSheetLocks ExamSheetLock[]
  examSeats      ExamSeat[]
  examDuties     ExamDuty[]
  examPapers     ExamPaper[]
  studentHealth  StudentHealth[]
  examRechecks   ExamRecheck[]

  salaryStructures   SalaryStructure[]
  staffSalaries      StaffSalary[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  payrollAdjustments PayrollAdjustment[]
  staffLoans         StaffLoan[]

  accGroups   AccGroup[]
  accLedgers  AccLedger[]
  accYears    AccYear[]
  accVouchers AccVoucher[]
  accEntries  AccEntry[]

  hostels             Hostel[]
  hostelRooms         HostelRoom[]
  hostelAllotments    HostelAllotment[]
  hostelRollCalls     HostelRollCall[]
  hostelLeaves        HostelLeave[]
  hostelVisitorAllows HostelVisitorAllow[]
  hostelMedical       HostelMedical[]
  hostelNotes         HostelNote[]

  messPlans         MessPlan[]
  messSubscriptions MessSubscription[]
  messMenus         MessMenu[]
  messSpecials      MessSpecial[]
  messSkips         MessSkip[]
  messServes        MessServe[]
  messRatings       MessRating[]

  userDashboards UserDashboard[]
  customWidgets  CustomWidget[]
  aiChats        AiChat[]
  aiChatMessages AiChatMessage[]

  @@map("tenants")
}

/// One row per school: name, contact, affiliation and locale. Shown on headers, reports, receipts, ID cards.
model SchoolProfile {
  tenantId               String   @id @map("tenant_id") @db.Uuid
  legalName              String   @map("legal_name")
  shortName              String?  @map("short_name")
  logoFileId             String?  @map("logo_file_id") @db.Uuid
  /// The principal's signature on report cards and admit cards.
  signatureFileId        String?  @map("signature_file_id") @db.Uuid
  addressLine1           String?  @map("address_line1")
  addressLine2           String?  @map("address_line2")
  city                   String?
  district               String?
  state                  String?
  pincode                String?
  country                String   @default("India")
  phone                  String?
  email                  String?
  website                String?
  /// CBSE / ICSE / State board …
  board                  String?
  affiliationNo          String?  @map("affiliation_no")
  udiseCode              String?  @map("udise_code")
  establishedYear        Int?     @map("established_year")
  timeZone               String   @default("Asia/Kolkata") @map("time_zone")
  dateFormat             String   @default("DD-MM-YYYY") @map("date_format")
  currency               String   @default("INR")
  /// 1 = January … 12 = December
  academicYearStartMonth Int      @default(4) @map("academic_year_start_month") @db.SmallInt
  // Sign-in page (left panel)
  loginBackgroundFileId  String?  @map("login_background_file_id") @db.Uuid
  /// Which part of the photo stays visible when it is cropped: center / top / bottom / left / right
  loginBackgroundFocus   String   @default("center") @map("login_background_focus")
  /// Darkening over the photo so white text stays readable, 0–90 (%)
  loginOverlay           Int      @default(60) @map("login_overlay") @db.SmallInt
  loginQuote             String?  @map("login_quote")
  loginQuoteAuthor       String?  @map("login_quote_author")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy              String?  @map("created_by") @db.Uuid
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy              String?  @map("updated_by") @db.Uuid

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  logo            File?  @relation(fields: [logoFileId], references: [id], onDelete: SetNull)
  loginBackground File?  @relation("SchoolLoginBackground", fields: [loginBackgroundFileId], references: [id], onDelete: SetNull)

  @@map("school_profiles")
}

// ─── Accounts ───────────────────────────────────────────────────────────────

enum UserKind {
  admin
  staff
  student
  guardian

  @@map("user_kind")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

/// Only people who sign in. Personal details live on the person record (staff / student / guardian).
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  kind               UserKind
  /// Stored lower-case.
  username           String
  /// Stored lower-case; real addresses only (no placeholders).
  email              String?
  mobile             String?
  displayName        String     @map("display_name")
  passwordHash       String     @map("password_hash")
  status             UserStatus @default(active)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(6)
  mfaEnabled         Boolean    @default(false) @map("mfa_enabled")
  /// AES-GCM encrypted; never returned by the API.
  mfaSecretEnc       String?    @map("mfa_secret_enc")
  avatarFileId       String?    @map("avatar_file_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?    @map("created_by") @db.Uuid
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?    @map("updated_by") @db.Uuid
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?    @map("deleted_by") @db.Uuid
  /// Created by the demo data script (removed by `npm run demo:clear`).
  isDemo             Boolean    @default(false) @map("is_demo")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  avatar          File?             @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  sessions        UserSession[]
  passwordResets  PasswordReset[]
  passwordHistory PasswordHistory[]
  roles           UserRole[]
  staffLogin      Staff?            @relation("StaffLogin")
  studentLogin    Student?          @relation("StudentLogin")
  guardianLogin   Guardian?         @relation("GuardianLogin")

  @@unique([id, tenantId])
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@unique([tenantId, mobile])
  @@index([tenantId, kind])
  @@map("users")
}

/// One row per signed-in device. The refresh token itself is never stored, only its hash.
model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  /// Hash of the token this one replaced; seeing it again means the old token was copied.
  previousTokenHash String?   @unique @map("previous_token_hash")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// logout / logout_all / password_changed / reuse_detected / admin / expired
  revokedReason     String?   @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("user_sessions")
}

model PasswordReset {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts    Int       @default(0)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("password_resets")
}

/// Previous password hashes, for the "can't reuse the last N passwords" rule.
model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@map("password_history")
}

// ─── Roles & permissions ────────────────────────────────────────────────────

enum DataScope {
  /// everything in the school
  all
  /// only the classes / sections the user is assigned to
  assigned
  /// only records linked to the user
  own

  @@map("data_scope")
}

/// System-wide catalogue, filled from the code registry at startup (not edited by hand).
model Permission {
  /// resource.action, e.g. student.create
  key         String      @id
  module      String
  resource    String
  action      String
  label       String
  description String?
  /// e.g. student.view_sensitive (Aadhaar, income)
  isSensitive Boolean     @default(false) @map("is_sensitive")
  /// which data scopes make sense for this permission
  scopes      DataScope[] @default([all])
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  slug        String
  description String?
  /// Super Admin: every permission, can't be deleted or emptied.
  isSystem    Boolean   @default(false) @map("is_system")
  /// Given automatically to new logins of this kind.
  defaultFor  UserKind? @map("default_for")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by") @db.Uuid

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model RolePermission {
  tenantId      String    @map("tenant_id") @db.Uuid
  roleId        String    @map("role_id") @db.Uuid
  permissionKey String    @map("permission_key")
  scope         DataScope @default(all)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionKey])
  @@index([tenantId])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

/// A school's rename / reorder / hide of sidebar items (the items come from code).
model MenuCustomization {
  tenantId  String   @map("tenant_id") @db.Uuid
  menuKey   String   @map("menu_key")
  label     String?
  sortOrder Int?     @map("sort_order")
  hidden    Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, menuKey])
  @@map("menu_customizations")
}

// ─── Settings & audit ───────────────────────────────────────────────────────

/// A school's own wording for an email (subject + body with {{placeholders}}). No row = the default from code.
model EmailTemplate {
  tenantId  String   @map("tenant_id") @db.Uuid
  /// e.g. password_reset, welcome
  key       String
  subject   String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("email_templates")
}

/// Only overrides are stored; a setting with no row uses its default from code.
model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("tenant_settings")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tenantId  String   @map("tenant_id") @db.Uuid
  at        DateTime @default(now()) @db.Timestamptz(6)
  userId    String?  @map("user_id") @db.Uuid
  /// create / update / delete / restore / login / login_failed / logout / password_change / … / import / export
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  /// { "field": [old, new] }; secret fields masked
  changes   Json?
  ip        String?
  userAgent String?  @map("user_agent")
  requestId String?  @map("request_id")

  @@index([tenantId, at(sort: Desc)])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId, at(sort: Desc)])
  @@map("audit_logs")
}

// ─── Files & imports ────────────────────────────────────────────────────────

enum ImportStatus {
  validated
  importing
  done
  failed

  @@map("import_status")
}

model File {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  /// local / cloudinary / s3
  provider     String
  storageKey   String    @map("storage_key")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  /// avatar / logo / import / document
  purpose      String
  uploadedBy   String?   @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schoolLogos            SchoolProfile[]
  schoolLoginBackgrounds SchoolProfile[] @relation("SchoolLoginBackground")
  userAvatars            User[]          @relation("UserAvatar")
  importJobs             ImportJob[]

  studentPhotos    Student[]         @relation("StudentPhoto")
  studentDocuments StudentDocument[] @relation("StudentDocumentFile")

  staffPhotos    Staff[]         @relation("StaffPhoto")
  staffDocuments StaffDocument[] @relation("StaffDocumentFile")

  @@index([tenantId, purpose])
  @@map("files")
}

model ImportJob {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  /// e.g. students, staff, users
  kind         String
  status       ImportStatus
  fileId       String?      @map("file_id") @db.Uuid
  options      Json?
  totalRows    Int          @default(0) @map("total_rows")
  validRows    Int          @default(0) @map("valid_rows")
  importedRows Int          @default(0) @map("imported_rows")
  /// [{ row, field, message }]
  errorRows    Json?        @map("error_rows")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?      @map("created_by") @db.Uuid
  finishedAt   DateTime?    @map("finished_at") @db.Timestamptz(6)

  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([tenantId, kind, createdAt(sort: Desc)])
  @@map("import_jobs")
}

/// One option of a master list (state, religion, blood group…). Which lists exist, their parent
/// list and extra fields are declared in code (modules/masters). Names are unique per list and
/// parent, codes per list (case-insensitive, indexes in the migration).
model MasterValue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// The list's key, e.g. "state".
  master    String
  name      String
  code      String?
  /// The option of the parent list (a district's state, a city's district).
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  /// Inactive options stay on existing records but can't be chosen for new ones.
  isActive  Boolean  @default(true) @map("is_active")
  /// The list's extra fields (e.g. a bank's IFSC prefix).
  extra     Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classesInGroup         SchoolClass[]        @relation("ClassGroup")
  sectionsOfStream       Section[]            @relation("SectionStream")
  subjectsOfType         Subject[]            @relation("SubjectType")
  classSubjectsOfStream  ClassSubject[]       @relation("ClassSubjectStream")
  guardiansRelation      Guardian[]           @relation("GuardianRelation")
  guardiansOccupation    Guardian[]           @relation("GuardianOccupation")
  guardiansQualification Guardian[]           @relation("GuardianQualification")
  guardiansIncome        Guardian[]           @relation("GuardianIncome")
  studentsAdmissionType  Student[]            @relation("StudentAdmissionType")
  studentsGender         Student[]            @relation("StudentGender")
  studentsBloodGroup     Student[]            @relation("StudentBloodGroup")
  studentsReligion       Student[]            @relation("StudentReligion")
  studentsCaste          Student[]            @relation("StudentCaste")
  studentsMotherTongue   Student[]            @relation("StudentMotherTongue")
  studentsNationality    Student[]            @relation("StudentNationality")
  studentsDisability     Student[]            @relation("StudentDisability")
  studentsCategory       Student[]            @relation("StudentCategory")
  studentsState          Student[]            @relation("StudentState")
  studentsDistrict       Student[]            @relation("StudentDistrict")
  studentsCity           Student[]            @relation("StudentCity")
  studentsPreviousBoard  Student[]            @relation("StudentPreviousBoard")
  studentsLeavingReason  Student[]            @relation("StudentLeavingReason")
  enrolmentsHouse        Enrolment[]          @relation("EnrolmentHouse")
  studentDocumentsType   StudentDocument[]    @relation("StudentDocumentType")
  enquiriesGender        Enquiry[]            @relation("EnquiryGender")
  enquiriesRelation      Enquiry[]            @relation("EnquiryRelation")
  enquiriesSource        Enquiry[]            @relation("EnquirySource")
  enquiriesStage         Enquiry[]            @relation("EnquiryStage")
  enquiriesLost          Enquiry[]            @relation("EnquiryLostReason")
  followUpsOutcome       EnquiryFollowUp[]    @relation("FollowUpOutcome")
  feeStructureLines      FeeStructureLine[]   @relation("FeeStructureHead")
  feeConcessionLines     FeeConcessionLine[]  @relation("FeeConcessionHead")
  feeAdjustments         FeeAdjustment[]      @relation("FeeAdjustmentHead")
  feeReceiptLines        FeeReceiptLine[]     @relation("FeeReceiptHead")
  ttLoadsStream          TtLoad[]             @relation("TtLoadStream")
  ttLoadsRoom            TtLoad[]             @relation("TtLoadRoom")
  ttEntriesRoom          TtEntry[]            @relation("TtEntryRoom")
  staffGender            Staff[]              @relation("StaffGender")
  staffBloodGroup        Staff[]              @relation("StaffBloodGroup")
  staffReligion          Staff[]              @relation("StaffReligion")
  staffCaste             Staff[]              @relation("StaffCaste")
  staffMarital           Staff[]              @relation("StaffMarital")
  staffState             Staff[]              @relation("StaffState")
  staffDistrict          Staff[]              @relation("StaffDistrict")
  staffCity              Staff[]              @relation("StaffCity")
  staffDepartment        Staff[]              @relation("StaffDepartment")
  staffDesignation       Staff[]              @relation("StaffDesignation")
  staffType              Staff[]              @relation("StaffType")
  staffEmployment        Staff[]              @relation("StaffEmployment")
  staffTeachingPost      Staff[]              @relation("StaffTeachingPost")
  staffBank              Staff[]              @relation("StaffBank")
  staffRelieving         Staff[]              @relation("StaffRelieving")
  staffQualifications    StaffQualification[] @relation("StaffQualificationType")
  staffDocumentsType     StaffDocument[]      @relation("StaffDocumentType")
  /// Through (parent_id, tenant_id): a parent option always belongs to the same school.
  parent                 MasterValue?         @relation("MasterValueParent", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  children               MasterValue[]        @relation("MasterValueParent")

  attendanceMarks AttendanceMark[]  @relation("AttendanceMarkStatus")
  staffAttendance StaffAttendance[] @relation("StaffAttendanceStatus")

  @@unique([id, tenantId])
  @@index([tenantId, master, parentId, sortOrder])
  @@map("master_values")
}

// ─── Academic setup ──────────────────────────────────────────────────────────

enum AcademicYearStatus {
  open
  /// Finished: its sections and subjects can no longer be changed.
  closed
}

/// A session, e.g. 2026–27. At most one is the current year (index in the migration).
model AcademicYear {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  name      String
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  isCurrent Boolean            @default(false) @map("is_current")
  status    AcademicYearStatus @default(open)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?            @map("created_by") @db.Uuid
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?            @map("updated_by") @db.Uuid

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections            Section[]
  yearClasses         YearClass[]
  classSubjects       ClassSubject[]
  enrolments          Enrolment[]
  teachingAssignments TeachingAssignment[]
  enquiries           Enquiry[]
  feeInstalments      FeeInstalment[]
  feeStructureLines   FeeStructureLine[]
  feeConcessions      FeeConcession[]
  feeAdjustments      FeeAdjustment[]
  feeReceipts         FeeReceipt[]
  ttSchedules         TtSchedule[]
  ttDays              TtDay[]
  ttLoads             TtLoad[]
  ttTeacherRules      TtTeacherRule[]
  timetables          Timetable[]

  @@unique([id, tenantId])
  @@index([tenantId, startDate])
  @@map("academic_years")
}

/// A class (grade), e.g. Class VI. The same classes run every year; sections are per year.
model SchoolClass {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  /// Short form for lists and reports, e.g. "VI".
  shortName   String?  @map("short_name")
  /// Master "class_group" (Primary, Middle…), used to apply fees or exams to many classes.
  groupId     String?  @map("group_id") @db.Uuid
  /// Sections and subjects are split by stream (Science, Commerce…), e.g. XI and XII.
  hasStreams  Boolean  @default(false) @map("has_streams")
  /// The class students are promoted to (empty = the next class in order; none after the last).
  nextClassId String?  @map("next_class_id") @db.Uuid
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group             MasterValue?       @relation("ClassGroup", fields: [groupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sections          Section[]
  inYears           YearClass[]
  classSubjects     ClassSubject[]
  enquiries         Enquiry[]
  feeStructureLines FeeStructureLine[]
  ttLoads           TtLoad[]

  @@unique([id, tenantId])
  @@index([tenantId, sortOrder])
  @@map("classes")
}

/// A section of a class in one year, e.g. VI-A in 2026–27.
model Section {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  name           String
  /// Master "stream"; set exactly when the class has streams.
  streamId       String?  @map("stream_id") @db.Uuid
  capacity       Int?
  room           String?
  /// A staff member (System Settings → Academic: one section per class teacher).
  classTeacherId String?  @map("class_teacher_staff_id") @db.Uuid
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear         @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  schoolClass         SchoolClass          @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stream              MasterValue?         @relation("SectionStream", fields: [streamId, tenantId], references: [id, tenantId], onDelete: Restrict)
  /// Same school (through tenant_id). Users are never hard-deleted, only disabled or soft-deleted.
  enrolments          Enrolment[]
  classTeacher        Staff?               @relation("SectionClassTeacher", fields: [classTeacherId, tenantId], references: [id, tenantId], onDelete: Restrict)
  teachingAssignments TeachingAssignment[]
  ttEntries           TtEntry[]
  ttSubstitutions     TtSubstitution[]

  attendanceSheets AttendanceSheet[]

  @@unique([id, tenantId])
  @@index([tenantId, academicYearId, classId])
  @@map("sections")
}

enum SubjectAssessment {
  /// Marks / grades on the report card.
  scholastic
  /// Art, PE, work education… (graded separately on CBSE report cards).
  co_scholastic
}

model Subject {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  name       String
  code       String?
  /// Master "subject_type" (Theory, Theory + practical, Activity…).
  typeId     String?           @map("type_id") @db.Uuid
  assessment SubjectAssessment @default(scholastic)
  sortOrder  Int               @default(0) @map("sort_order")
  isActive   Boolean           @default(true) @map("is_active")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?           @map("created_by") @db.Uuid
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy  String?           @map("updated_by") @db.Uuid

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                MasterValue?         @relation("SubjectType", fields: [typeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  classSubjects       ClassSubject[]
  teachingAssignments TeachingAssignment[]
  ttLoads             TtLoad[]
  ttEntries           TtEntry[]
  ttSubstitutions     TtSubstitution[]

  @@unique([id, tenantId])
  @@index([tenantId, sortOrder])
  @@map("subjects")
}

/// A subject a class studies in one year; with a stream it applies to that stream's sections only.
model ClassSubject {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  /// Empty = every stream (or the class has no streams).
  streamId       String?  @map("stream_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  /// Optional / elective: each student picks from these (e.g. Hindi or Sanskrit).
  isOptional     Boolean  @default(false) @map("is_optional")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  schoolClass  SchoolClass  @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stream       MasterValue? @relation("ClassSubjectStream", fields: [streamId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, academicYearId, classId])
  @@map("class_subjects")
}

// ─── Students ────────────────────────────────────────────────────────────────

/// Running counters for numbers the school formats itself (admission numbers, later receipts).
/// `key` includes what the counter restarts by, e.g. "admission:2026-27".
model NumberSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  /// The last number given out.
  lastValue Int      @default(0) @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("number_sequences")
}

/// A household: the parents / guardians shared by siblings.
model Family {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Created by the demo data script (removed by `npm run demo:clear`).
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guardians Guardian[]
  students  Student[]

  @@unique([id, tenantId])
  @@map("families")
}

model Guardian {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  familyId        String   @map("family_id") @db.Uuid
  /// Master "relation" (Father, Mother, Guardian…).
  relationId      String?  @map("relation_id") @db.Uuid
  name            String
  mobile          String?
  email           String?
  occupationId    String?  @map("occupation_id") @db.Uuid
  qualificationId String?  @map("qualification_id") @db.Uuid
  incomeRangeId   String?  @map("income_range_id") @db.Uuid
  /// Sensitive (student.view_sensitive).
  aadhaar         String?
  /// The one the school contacts first.
  isPrimary       Boolean  @default(false) @map("is_primary")
  /// Parent login (optional, System Settings → Students).
  userId          String?  @map("user_id") @db.Uuid
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?  @map("updated_by") @db.Uuid

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family        Family       @relation(fields: [familyId, tenantId], references: [id, tenantId], onDelete: Cascade)
  relation      MasterValue? @relation("GuardianRelation", fields: [relationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  occupation    MasterValue? @relation("GuardianOccupation", fields: [occupationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  qualification MasterValue? @relation("GuardianQualification", fields: [qualificationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  incomeRange   MasterValue? @relation("GuardianIncome", fields: [incomeRangeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user          User?        @relation("GuardianLogin", fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, familyId])
  @@index([tenantId, mobile])
  @@map("guardians")
}

enum StudentStatus {
  active
  /// Left the school (transfer certificate issued).
  left
  passed_out
  struck_off
}

model Student {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  admissionNo     String        @map("admission_no")
  admissionDate   DateTime      @map("admission_date") @db.Date
  admissionTypeId String?       @map("admission_type_id") @db.Uuid
  firstName       String        @map("first_name")
  middleName      String?       @map("middle_name")
  lastName        String?       @map("last_name")
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  genderId        String?       @map("gender_id") @db.Uuid
  bloodGroupId    String?       @map("blood_group_id") @db.Uuid
  religionId      String?       @map("religion_id") @db.Uuid
  casteCategoryId String?       @map("caste_category_id") @db.Uuid
  motherTongueId  String?       @map("mother_tongue_id") @db.Uuid
  nationalityId   String?       @map("nationality_id") @db.Uuid
  disabilityId    String?       @map("disability_id") @db.Uuid
  /// Master "student_category" (e.g. KV admission priority category).
  categoryId      String?       @map("category_id") @db.Uuid
  /// Sensitive (student.view_sensitive).
  aadhaar         String?
  apaarId         String?       @map("apaar_id")
  /// UDISE+ Permanent Education Number.
  pen             String?
  mobile          String?
  email           String?
  addressLine     String?       @map("address_line")
  stateId         String?       @map("state_id") @db.Uuid
  districtId      String?       @map("district_id") @db.Uuid
  cityId          String?       @map("city_id") @db.Uuid
  pinCode         String?       @map("pin_code")
  previousSchool  String?       @map("previous_school")
  previousBoardId String?       @map("previous_board_id") @db.Uuid
  previousClass   String?       @map("previous_class")
  tcNumber        String?       @map("tc_number")
  /// Sensitive (student.view_sensitive).
  medicalNotes    String?       @map("medical_notes")
  emergencyName   String?       @map("emergency_name")
  emergencyPhone  String?       @map("emergency_phone")
  photoFileId     String?       @map("photo_file_id") @db.Uuid
  familyId        String?       @map("family_id") @db.Uuid
  /// The student's own login.
  userId          String?       @map("user_id") @db.Uuid
  status          StudentStatus @default(active)
  statusDate      DateTime?     @map("status_date") @db.Date
  leavingReasonId String?       @map("leaving_reason_id") @db.Uuid
  statusNote      String?       @map("status_note")
  isDemo          Boolean       @default(false) @map("is_demo")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?       @map("created_by") @db.Uuid
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?       @map("updated_by") @db.Uuid

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family         Family?                @relation(fields: [familyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user           User?                  @relation("StudentLogin", fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  photo          File?                  @relation("StudentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  admissionType  MasterValue?           @relation("StudentAdmissionType", fields: [admissionTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  gender         MasterValue?           @relation("StudentGender", fields: [genderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  bloodGroup     MasterValue?           @relation("StudentBloodGroup", fields: [bloodGroupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  religion       MasterValue?           @relation("StudentReligion", fields: [religionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  casteCategory  MasterValue?           @relation("StudentCaste", fields: [casteCategoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  motherTongue   MasterValue?           @relation("StudentMotherTongue", fields: [motherTongueId, tenantId], references: [id, tenantId], onDelete: Restrict)
  nationality    MasterValue?           @relation("StudentNationality", fields: [nationalityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  disability     MasterValue?           @relation("StudentDisability", fields: [disabilityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  category       MasterValue?           @relation("StudentCategory", fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  state          MasterValue?           @relation("StudentState", fields: [stateId, tenantId], references: [id, tenantId], onDelete: Restrict)
  district       MasterValue?           @relation("StudentDistrict", fields: [districtId, tenantId], references: [id, tenantId], onDelete: Restrict)
  city           MasterValue?           @relation("StudentCity", fields: [cityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  previousBoard  MasterValue?           @relation("StudentPreviousBoard", fields: [previousBoardId, tenantId], references: [id, tenantId], onDelete: Restrict)
  leavingReason  MasterValue?           @relation("StudentLeavingReason", fields: [leavingReasonId, tenantId], references: [id, tenantId], onDelete: Restrict)
  promotions     StudentPromotion[]
  tcs            TransferCertificate[]
  enrolments     Enrolment[]
  documents      StudentDocument[]
  enquiries      Enquiry[]              @relation("EnquiryStudent")
  feeConcessions StudentFeeConcession[]
  feeAdjustments FeeAdjustment[]
  feeReceipts    FeeReceipt[]
  onlinePayments OnlinePayment[]

  attendanceMarks AttendanceMark[]

  leaves StudentLeave[]

  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, familyId])
  @@map("students")
}

/// A student's place in one academic year: section, roll number, house, chosen optional subjects.
model Enrolment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  academicYearId     String   @map("academic_year_id") @db.Uuid
  sectionId          String   @map("section_id") @db.Uuid
  rollNumber         Int?     @map("roll_number")
  houseId            String?  @map("house_id") @db.Uuid
  /// Optional subjects the student chose (subject ids of the class's optional subjects).
  optionalSubjectIds String[] @default([]) @map("optional_subject_ids") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy          String?  @map("created_by") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy          String?  @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  section      Section      @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  house        MasterValue? @relation("EnrolmentHouse", fields: [houseId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([studentId, academicYearId])
  @@index([tenantId, sectionId])
  @@map("enrolments")
}

model StudentDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  /// Master "student_document".
  typeId    String?  @map("type_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  type    MasterValue? @relation("StudentDocumentType", fields: [typeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  file    File         @relation("StudentDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([tenantId, studentId])
  @@map("student_documents")
}

// ─── Staff ───────────────────────────────────────────────────────────────────

enum StaffStatus {
  working
  relieved
  retired
  suspended
}

model Staff {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  employeeCode        String      @map("employee_code")
  joiningDate         DateTime    @map("joining_date") @db.Date
  firstName           String      @map("first_name")
  middleName          String?     @map("middle_name")
  lastName            String?     @map("last_name")
  dateOfBirth         DateTime?   @map("date_of_birth") @db.Date
  genderId            String?     @map("gender_id") @db.Uuid
  bloodGroupId        String?     @map("blood_group_id") @db.Uuid
  religionId          String?     @map("religion_id") @db.Uuid
  casteCategoryId     String?     @map("caste_category_id") @db.Uuid
  maritalStatusId     String?     @map("marital_status_id") @db.Uuid
  mobile              String?
  email               String?
  /// Sensitive (staff.view_sensitive).
  aadhaar             String?
  /// Sensitive (staff.view_sensitive).
  pan                 String?
  addressLine         String?     @map("address_line")
  stateId             String?     @map("state_id") @db.Uuid
  districtId          String?     @map("district_id") @db.Uuid
  cityId              String?     @map("city_id") @db.Uuid
  pinCode             String?     @map("pin_code")
  departmentId        String?     @map("department_id") @db.Uuid
  designationId       String?     @map("designation_id") @db.Uuid
  /// Master "staff_type" (Teaching / Non-teaching).
  staffTypeId         String?     @map("staff_type_id") @db.Uuid
  employmentTypeId    String?     @map("employment_type_id") @db.Uuid
  /// Master "teaching_post" (PRT / TGT / PGT…), teachers only.
  teachingPostId      String?     @map("teaching_post_id") @db.Uuid
  reportsToId         String?     @map("reports_to_id") @db.Uuid
  /// Subjects the person is able to teach (subject ids).
  teachableSubjectIds String[]    @default([]) @map("teachable_subject_ids") @db.Uuid
  bankId              String?     @map("bank_id") @db.Uuid
  /// Sensitive (staff.view_sensitive).
  bankAccountNo       String?     @map("bank_account_no")
  ifsc                String?
  /// Sensitive (staff.view_sensitive).
  pfNumber            String?     @map("pf_number")
  uan                 String?
  emergencyName       String?     @map("emergency_name")
  emergencyPhone      String?     @map("emergency_phone")
  /// The person's number on the school's attendance machine (biometric / card), to match its punches.
  deviceUserId        String?     @map("device_user_id")
  photoFileId         String?     @map("photo_file_id") @db.Uuid
  /// The staff member's login (optional: drivers or cooks may have none).
  userId              String?     @map("user_id") @db.Uuid
  status              StaffStatus @default(working)
  statusDate          DateTime?   @map("status_date") @db.Date
  relievingReasonId   String?     @map("relieving_reason_id") @db.Uuid
  statusNote          String?     @map("status_note")
  isDemo              Boolean     @default(false) @map("is_demo")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?     @map("created_by") @db.Uuid
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?     @map("updated_by") @db.Uuid

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?                @relation("StaffLogin", fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  photo           File?                @relation("StaffPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  reportsTo       Staff?               @relation("StaffReportsTo", fields: [reportsToId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reports         Staff[]              @relation("StaffReportsTo")
  gender          MasterValue?         @relation("StaffGender", fields: [genderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  bloodGroup      MasterValue?         @relation("StaffBloodGroup", fields: [bloodGroupId, tenantId], references: [id, tenantId], onDelete: Restrict)
  religion        MasterValue?         @relation("StaffReligion", fields: [religionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  casteCategory   MasterValue?         @relation("StaffCaste", fields: [casteCategoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  maritalStatus   MasterValue?         @relation("StaffMarital", fields: [maritalStatusId, tenantId], references: [id, tenantId], onDelete: Restrict)
  state           MasterValue?         @relation("StaffState", fields: [stateId, tenantId], references: [id, tenantId], onDelete: Restrict)
  district        MasterValue?         @relation("StaffDistrict", fields: [districtId, tenantId], references: [id, tenantId], onDelete: Restrict)
  city            MasterValue?         @relation("StaffCity", fields: [cityId, tenantId], references: [id, tenantId], onDelete: Restrict)
  department      MasterValue?         @relation("StaffDepartment", fields: [departmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  designation     MasterValue?         @relation("StaffDesignation", fields: [designationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  staffType       MasterValue?         @relation("StaffType", fields: [staffTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employmentType  MasterValue?         @relation("StaffEmployment", fields: [employmentTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  teachingPost    MasterValue?         @relation("StaffTeachingPost", fields: [teachingPostId, tenantId], references: [id, tenantId], onDelete: Restrict)
  bank            MasterValue?         @relation("StaffBank", fields: [bankId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relievingReason MasterValue?         @relation("StaffRelieving", fields: [relievingReasonId, tenantId], references: [id, tenantId], onDelete: Restrict)
  qualifications  StaffQualification[]
  experience      StaffExperience[]
  documents       StaffDocument[]
  classTeacherOf  Section[]            @relation("SectionClassTeacher")
  assignments     TeachingAssignment[]
  enquiries       Enquiry[]            @relation("EnquiryAssignedTo")
  ttRules         TtTeacherRule[]      @relation("TtTeacherRule")
  ttEntries       TtEntry[]            @relation("TtEntryStaff")
  ttAbsences      TtSubstitution[]     @relation("TtSubAbsent")
  ttSubstitutions TtSubstitution[]     @relation("TtSubSubstitute")

  attendance StaffAttendance[]

  attendanceRequests StaffAttendanceRequest[]

  face StaffFace?

  phone   StaffPhone?
  punches AttendancePunch[]

  leaves       StaffLeave[]
  leaveEntries LeaveEntry[]

  @@unique([tenantId, deviceUserId])
  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("staff")
}

model StaffQualification {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  /// Master "qualification" (Graduate, B.Ed…).
  qualificationId String?  @map("qualification_id") @db.Uuid
  subject         String?
  institution     String?
  year            Int?
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff         Staff        @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)
  qualification MasterValue? @relation("StaffQualificationType", fields: [qualificationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, staffId])
  @@map("staff_qualifications")
}

model StaffExperience {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  organisation String
  role         String?
  fromDate     DateTime? @map("from_date") @db.Date
  toDate       DateTime? @map("to_date") @db.Date
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, staffId])
  @@map("staff_experience")
}

model StaffDocument {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  /// Master "staff_document".
  typeId    String?  @map("type_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff        @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)
  type   MasterValue? @relation("StaffDocumentType", fields: [typeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  file   File         @relation("StaffDocumentFile", fields: [fileId], references: [id], onDelete: Restrict)

  @@index([tenantId, staffId])
  @@map("staff_documents")
}

/// Who teaches a subject to a section (the section fixes the year). One teacher per subject and section.
model TeachingAssignment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  sectionId      String   @map("section_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  section      Section      @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  staff        Staff        @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([sectionId, subjectId])
  @@index([tenantId, academicYearId, staffId])
  @@map("teaching_assignments")
}

// ─── Admissions: enquiries and follow-ups ────────────────────────────────────

/// A family asking about admission; followed up until admitted (converted to a student) or lost.
model Enquiry {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  enquiryNo           String    @map("enquiry_no")
  enquiryDate         DateTime  @map("enquiry_date") @db.Date
  academicYearId      String    @map("academic_year_id") @db.Uuid
  /// The class applied for.
  classId             String    @map("class_id") @db.Uuid
  studentFirstName    String    @map("student_first_name")
  studentLastName     String?   @map("student_last_name")
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  genderId            String?   @map("gender_id") @db.Uuid
  parentName          String    @map("parent_name")
  relationId          String?   @map("relation_id") @db.Uuid
  mobile              String
  email               String?
  area                String?
  currentSchool       String?   @map("current_school")
  /// Master "enquiry_source" (walk-in, phone, website…).
  sourceId            String?   @map("source_id") @db.Uuid
  /// Master "enquiry_stage" (Enquiry, Registered, … Admitted, Lost).
  stageId             String    @map("stage_id") @db.Uuid
  /// The staff member following it up.
  assignedToId        String?   @map("assigned_to_id") @db.Uuid
  nextFollowUp        DateTime? @map("next_follow_up") @db.Date
  lostReasonId        String?   @map("lost_reason_id") @db.Uuid
  registrationNo      String?   @map("registration_no")
  registrationDate    DateTime? @map("registration_date") @db.Date
  /// Registration fee received (rupees), how and its reference.
  registrationFee     Int?      @map("registration_fee")
  registrationFeeMode String?   @map("registration_fee_mode")
  registrationFeeRef  String?   @map("registration_fee_ref")
  testDate            DateTime? @map("test_date") @db.Date
  testScore           String?   @map("test_score")
  testResult          String    @default("not_needed") @map("test_result")
  remarks             String?
  /// Came in through the public enquiry form.
  online              Boolean   @default(false)
  /// The student it became (Convert to admission).
  studentId           String?   @map("student_id") @db.Uuid
  convertedAt         DateTime? @map("converted_at") @db.Timestamptz(6)
  isDemo              Boolean   @default(false) @map("is_demo")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy           String?   @map("updated_by") @db.Uuid

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear      @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  schoolClass    SchoolClass       @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Restrict)
  gender         MasterValue?      @relation("EnquiryGender", fields: [genderId, tenantId], references: [id, tenantId], onDelete: Restrict)
  relation       MasterValue?      @relation("EnquiryRelation", fields: [relationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  source         MasterValue?      @relation("EnquirySource", fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stage          MasterValue       @relation("EnquiryStage", fields: [stageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lostReason     MasterValue?      @relation("EnquiryLostReason", fields: [lostReasonId, tenantId], references: [id, tenantId], onDelete: Restrict)
  assignedTo     Staff?            @relation("EnquiryAssignedTo", fields: [assignedToId, tenantId], references: [id, tenantId], onDelete: Restrict)
  student        Student?          @relation("EnquiryStudent", fields: [studentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  followUps      EnquiryFollowUp[]
  onlinePayments OnlinePayment[]

  @@unique([id, tenantId])
  @@index([tenantId, stageId])
  @@index([tenantId, nextFollowUp])
  @@index([tenantId, mobile])
  @@map("enquiries")
}

/// One call, visit or message about an enquiry, with what was said and when to follow up next.
model EnquiryFollowUp {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  enquiryId String    @map("enquiry_id") @db.Uuid
  date      DateTime  @db.Date
  /// Master "follow_up_outcome" (interested, call back, visit scheduled…).
  outcomeId String?   @map("outcome_id") @db.Uuid
  note      String?
  nextDate  DateTime? @map("next_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enquiry Enquiry      @relation(fields: [enquiryId, tenantId], references: [id, tenantId], onDelete: Cascade)
  outcome MasterValue? @relation("FollowUpOutcome", fields: [outcomeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, enquiryId])
  @@map("enquiry_follow_ups")
}

// ─── Fees: instalments, structure, concessions, receipts, online payments ────

enum ConcessionKind {
  percent
  amount
}

enum FeeReceiptStatus {
  active
  cancelled
}

enum OnlinePaymentPurpose {
  fees
  registration
}

enum OnlinePaymentStatus {
  created
  paid
  failed
}

/// One instalment of a year's fees (April, Quarter 1…), with its due date. Amounts are whole rupees everywhere.
model FeeInstalment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  dueDate        DateTime @map("due_date") @db.Date
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear       @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  structureLines FeeStructureLine[]
  adjustments    FeeAdjustment[]
  receiptLines   FeeReceiptLine[]

  @@unique([id, tenantId])
  @@index([tenantId, academicYearId, dueDate])
  @@map("fee_instalments")
}

/// What a class pays for a fee head in an instalment.
model FeeStructureLine {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  /// Master "fee_head".
  feeHeadId      String   @map("fee_head_id") @db.Uuid
  instalmentId   String   @map("instalment_id") @db.Uuid
  amount         Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  schoolClass  SchoolClass   @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Restrict)
  feeHead      MasterValue   @relation("FeeStructureHead", fields: [feeHeadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  instalment   FeeInstalment @relation(fields: [instalmentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, classId, feeHeadId, instalmentId])
  @@index([tenantId, academicYearId, classId])
  @@map("fee_structure_lines")
}

/// A concession of a year (girl child, SC/ST, staff ward…). Automatic ones apply to every student
/// matching all the non-empty conditions; the others are given to students one by one.
model FeeConcession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  academicYearId   String   @map("academic_year_id") @db.Uuid
  name             String
  automatic        Boolean  @default(false)
  /// Conditions (automatic only): master ids of gender, caste category, admission category; class ids.
  genderIds        String[] @default([]) @map("gender_ids") @db.Uuid
  casteCategoryIds String[] @default([]) @map("caste_category_ids") @db.Uuid
  categoryIds      String[] @default([]) @map("category_ids") @db.Uuid
  classIds         String[] @default([]) @map("class_ids") @db.Uuid
  note             String?
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?  @map("created_by") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?  @map("updated_by") @db.Uuid

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear           @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines        FeeConcessionLine[]
  students     StudentFeeConcession[]

  @@unique([id, tenantId])
  @@index([tenantId, academicYearId])
  @@map("fee_concessions")
}

/// How much of a fee head a concession takes off: a percent, or rupees per instalment.
model FeeConcessionLine {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  concessionId String         @map("concession_id") @db.Uuid
  feeHeadId    String         @map("fee_head_id") @db.Uuid
  kind         ConcessionKind
  value        Int

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  concession FeeConcession @relation(fields: [concessionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  feeHead    MasterValue   @relation("FeeConcessionHead", fields: [feeHeadId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([concessionId, feeHeadId])
  @@map("fee_concession_lines")
}

/// A (non-automatic) concession given to a student.
model StudentFeeConcession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  concessionId String   @map("concession_id") @db.Uuid
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  concession FeeConcession @relation(fields: [concessionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([studentId, concessionId])
  @@map("student_fee_concessions")
}

/// A one-off change to a student's dues: an extra charge (+) or a waiver (−) of a head, or of the late fine.
model FeeAdjustment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  instalmentId   String   @map("instalment_id") @db.Uuid
  /// Empty with isFine = the late fine of the instalment.
  feeHeadId      String?  @map("fee_head_id") @db.Uuid
  isFine         Boolean  @default(false) @map("is_fine")
  amount         Int
  reason         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student       @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  instalment   FeeInstalment @relation(fields: [instalmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  feeHead      MasterValue?  @relation("FeeAdjustmentHead", fields: [feeHeadId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, studentId, academicYearId])
  @@map("fee_adjustments")
}

/// Money received for a student (at the counter or online). Never edited; cancelled with a reason.
model FeeReceipt {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  receiptNo       String           @map("receipt_no")
  studentId       String           @map("student_id") @db.Uuid
  academicYearId  String           @map("academic_year_id") @db.Uuid
  date            DateTime         @db.Date
  mode            String
  /// Cheque / DD / UPI / transaction number.
  reference       String?
  bankName        String?          @map("bank_name")
  amount          Int
  note            String?
  status          FeeReceiptStatus @default(active)
  cancelledAt     DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy     String?          @map("cancelled_by") @db.Uuid
  cancelReason    String?          @map("cancel_reason")
  onlinePaymentId String?          @map("online_payment_id") @db.Uuid
  isDemo          Boolean          @default(false) @map("is_demo")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student       Student          @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  academicYear  AcademicYear     @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  onlinePayment OnlinePayment?   @relation(fields: [onlinePaymentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines         FeeReceiptLine[]

  @@unique([id, tenantId])
  @@unique([onlinePaymentId, tenantId])
  @@index([tenantId, date])
  @@index([tenantId, studentId])
  @@map("fee_receipts")
}

/// What a receipt paid: a fee head of an instalment, or that instalment's late fine.
model FeeReceiptLine {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  receiptId    String  @map("receipt_id") @db.Uuid
  instalmentId String  @map("instalment_id") @db.Uuid
  feeHeadId    String? @map("fee_head_id") @db.Uuid
  isFine       Boolean @default(false) @map("is_fine")
  amount       Int

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receipt    FeeReceipt    @relation(fields: [receiptId, tenantId], references: [id, tenantId], onDelete: Cascade)
  instalment FeeInstalment @relation(fields: [instalmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  feeHead    MasterValue?  @relation("FeeReceiptHead", fields: [feeHeadId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, receiptId])
  @@map("fee_receipt_lines")
}

/// The school's payment gateway account (one per school). Secrets are stored encrypted.
model PaymentGateway {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @unique @map("tenant_id") @db.Uuid
  /// "razorpay", or "mock" (a pretend gateway for trying the flow; never in production).
  provider             String
  keyId                String?  @map("key_id")
  keySecretEnc         String?  @map("key_secret_enc")
  webhookSecretEnc     String?  @map("webhook_secret_enc")
  /// "test" uses the key fields above; "live" uses the live ones (real money).
  mode                 String   @default("test")
  liveKeyId            String?  @map("live_key_id")
  liveKeySecretEnc     String?  @map("live_key_secret_enc")
  liveWebhookSecretEnc String?  @map("live_webhook_secret_enc")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy            String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_gateways")
}

/// One online payment attempt: an order at the gateway for an exact amount, paid or not.
model OnlinePayment {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  purpose        OnlinePaymentPurpose
  provider       String
  /// The gateway's order id.
  orderId        String               @map("order_id")
  /// The gateway's payment id once paid.
  paymentRef     String?              @map("payment_ref")
  /// Total charged, convenience fee included.
  amount         Int
  convenienceFee Int                  @default(0) @map("convenience_fee")
  status         OnlinePaymentStatus  @default(created)
  /// Which keys made it ("test" / "live"), so it is checked with the same ones.
  mode           String               @default("test")
  /// "checkout" = the gateway's payment window; "qr" = a UPI QR code for the exact amount.
  method         String               @default("checkout")
  qrImageUrl     String?              @map("qr_image_url")
  expiresAt      DateTime?            @map("expires_at") @db.Timestamptz(6)
  studentId      String?              @map("student_id") @db.Uuid
  enquiryId      String?              @map("enquiry_id") @db.Uuid
  academicYearId String?              @map("academic_year_id") @db.Uuid
  /// What it pays: [{ instalmentId, feeHeadId|null, isFine, amount }].
  allocation     Json                 @default("[]")
  /// The signed-in person who paid (empty on the website form).
  userId         String?              @map("user_id") @db.Uuid
  error          String?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt         DateTime?            @map("paid_at") @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student?    @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  enquiry Enquiry?    @relation(fields: [enquiryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  receipt FeeReceipt?

  @@unique([id, tenantId])
  @@unique([provider, orderId])
  @@index([tenantId, status])
  @@map("online_payments")
}

// ─── Time-table ───────────────────────────────────────────────────────────────

enum TtSlotKind {
  period
  break
}

enum TimetableStatus {
  draft
  published
  archived
}

/// A bell schedule of a year (Regular, Winter, Short Saturday…): its periods and breaks with times.
model TtSchedule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  slots        TtSlot[]
  days         TtDay[]

  @@unique([id, tenantId])
  @@index([tenantId, academicYearId])
  @@map("tt_schedules")
}

/// One row of a bell schedule: a period (numbered 1, 2…) or a break, with its start and end ("08:00").
model TtSlot {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  scheduleId String     @map("schedule_id") @db.Uuid
  sortOrder  Int        @map("sort_order")
  kind       TtSlotKind
  /// Periods only: 1, 2, 3… in order.
  periodNo   Int?       @map("period_no")
  label      String
  startTime  String     @map("start_time")
  endTime    String     @map("end_time")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedule TtSchedule @relation(fields: [scheduleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, scheduleId])
  @@map("tt_slots")
}

/// Which bell schedule a weekday follows (none = not a school day).
model TtDay {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  academicYearId String  @map("academic_year_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday.
  weekday        Int
  scheduleId     String? @map("schedule_id") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  schedule     TtSchedule?  @relation(fields: [scheduleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, academicYearId, weekday])
  @@map("tt_days")
}

/// How many periods a week a subject gets in a class (stream), how many of them as double periods,
/// whether it runs at the same time as other subjects (optional subjects: same group, same periods),
/// and the room it needs.
model TtLoad {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  streamId       String?  @map("stream_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  perWeek        Int      @map("per_week")
  doubles        Int      @default(0)
  parallelGroup  String?  @map("parallel_group")
  /// Master "room" (a lab, the computer room…); empty = the class's own room.
  roomId         String?  @map("room_id") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  schoolClass  SchoolClass  @relation(fields: [classId, tenantId], references: [id, tenantId], onDelete: Restrict)
  stream       MasterValue? @relation("TtLoadStream", fields: [streamId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subject      Subject      @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  room         MasterValue? @relation("TtLoadRoom", fields: [roomId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, academicYearId, classId])
  @@map("tt_loads")
}

/// A teacher's limits for the year: most periods a day / week, and periods they can't take.
model TtTeacherRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  staffId        String   @map("staff_id") @db.Uuid
  maxPerDay      Int?     @map("max_per_day")
  maxPerWeek     Int?     @map("max_per_week")
  /// [{ weekday, periodNo }]
  unavailable    Json     @default("[]")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?  @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  staff        Staff        @relation("TtTeacherRule", fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, academicYearId, staffId])
  @@map("tt_teacher_rules")
}

/// A timetable of a year: drafts are generated and edited; one is published (what everyone sees).
model Timetable {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  academicYearId String          @map("academic_year_id") @db.Uuid
  name           String
  status         TimetableStatus @default(draft)
  /// What the generator could not place: [{ sectionId, subjectId, missing, reason }].
  unplaced       Json            @default("[]")
  generatedAt    DateTime?       @map("generated_at") @db.Timestamptz(6)
  publishedAt    DateTime?       @map("published_at") @db.Timestamptz(6)
  isDemo         Boolean         @default(false) @map("is_demo")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?         @map("created_by") @db.Uuid
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?         @map("updated_by") @db.Uuid

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId, tenantId], references: [id, tenantId], onDelete: Restrict)
  entries      TtEntry[]

  @@unique([id, tenantId])
  @@index([tenantId, academicYearId, status])
  @@map("timetables")
}

/// One lesson in a timetable: a section's period on a weekday. Optional subjects of a parallel group
/// share the same period (one row each).
model TtEntry {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  timetableId String  @map("timetable_id") @db.Uuid
  sectionId   String  @map("section_id") @db.Uuid
  weekday     Int
  periodNo    Int     @map("period_no")
  subjectId   String  @map("subject_id") @db.Uuid
  staffId     String? @map("staff_id") @db.Uuid
  roomId      String? @map("room_id") @db.Uuid
  /// Kept as it is when the timetable is generated again.
  locked      Boolean @default(false)

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetable Timetable    @relation(fields: [timetableId, tenantId], references: [id, tenantId], onDelete: Cascade)
  section   Section      @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject   Subject      @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  staff     Staff?       @relation("TtEntryStaff", fields: [staffId, tenantId], references: [id, tenantId], onDelete: Restrict)
  room      MasterValue? @relation("TtEntryRoom", fields: [roomId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([timetableId, sectionId, weekday, periodNo, subjectId])
  @@index([tenantId, timetableId, staffId, weekday, periodNo])
  @@map("tt_entries")
}

/// On a date, someone else takes an absent teacher's period.
model TtSubstitution {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  date              DateTime @db.Date
  sectionId         String   @map("section_id") @db.Uuid
  periodNo          Int      @map("period_no")
  subjectId         String?  @map("subject_id") @db.Uuid
  absentStaffId     String   @map("absent_staff_id") @db.Uuid
  /// Empty = not arranged yet (the class is free / with the duty teacher).
  substituteStaffId String?  @map("substitute_staff_id") @db.Uuid
  note              String?
  isDemo            Boolean  @default(false) @map("is_demo")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy         String?  @map("updated_by") @db.Uuid

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  absent     Staff    @relation("TtSubAbsent", fields: [absentStaffId, tenantId], references: [id, tenantId], onDelete: Cascade)
  substitute Staff?   @relation("TtSubSubstitute", fields: [substituteStaffId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, date, sectionId, periodNo, absentStaffId])
  @@index([tenantId, date])
  @@map("tt_substitutions")
}

// ─── Documents ────────────────────────────────────────────────────────────────

/// A school's own version of a document template (fee receipt, due slip…); without one the built-in default is used.
model DocumentTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  html      String
  css       String   @default("")
  /// { size: "A4" | "A5" | "A4_HALF" | "THERMAL_80", orientation: "portrait" | "landscape", copies, margins mm }
  paper     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("document_templates")
}

/// A school's Jasper design (.jrxml) for a report; several versions, at most one in use.
model ReportDesign {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  reportKey String   @map("report_key")
  version   Int
  fileName  String   @map("file_name")
  note      String?
  jrxml     String
  /// What the design expects (fields, parameters, page), as the report service read it.
  info      Json     @default("{}")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportKey, version])
  @@index([tenantId, reportKey])
  @@map("report_designs")
}

/// How a school makes a report: auto (its Jasper design if there is one), jasper, or the built-in table.
model ReportSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  reportKey String   @map("report_key")
  engine    String   @default("auto")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reportKey])
  @@map("report_settings")
}

/// A report made in the Report Builder: a data source with the columns, filters, sorting and grouping chosen.
model CustomReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String   @default("")
  /// Library section it is listed under.
  category    String   @default("My reports")
  /// { source, params, columns, filters, sort, groupBy, orientation } (see builder.service).
  definition  Json
  /// Roles that may run it (besides people who build reports). Empty = only report builders.
  roleIds     String[] @default([]) @map("role_ids") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("custom_reports")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

/// A day the school is closed, or has no classes (exams, events): for students, staff or both.
model Holiday {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  date        DateTime @db.Date
  name        String
  forStudents Boolean  @default(true) @map("for_students")
  forStaff    Boolean  @default(true) @map("for_staff")
  /// Made by an event ("make this a holiday"); removed or changed with it.
  eventId     String?  @map("event_id") @db.Uuid
  isDemo      Boolean  @default(false) @map("is_demo")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("holidays")
}

/// One register: a section's attendance on a date. slot "day" (once a day), "am" / "pm" (twice a day).
model AttendanceSheet {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  date      DateTime @db.Date
  slot      String   @default("day")
  /// Who marked it first (the user) and when.
  markedBy  String?  @map("marked_by") @db.Uuid
  markedAt  DateTime @default(now()) @map("marked_at") @db.Timestamptz(6)
  isDemo    Boolean  @default(false) @map("is_demo")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section          @relation(fields: [sectionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  marks   AttendanceMark[]

  @@unique([id, tenantId])
  @@unique([tenantId, sectionId, date, slot])
  @@index([tenantId, date])
  @@map("attendance_sheets")
}

/// A student's status in a register (Present, Absent, Late… from the "attendance_status" list).
model AttendanceMark {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  sheetId   String  @map("sheet_id") @db.Uuid
  studentId String  @map("student_id") @db.Uuid
  statusId  String  @map("status_id") @db.Uuid
  note      String?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sheet   AttendanceSheet @relation(fields: [sheetId, tenantId], references: [id, tenantId], onDelete: Cascade)
  student Student         @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  status  MasterValue     @relation("AttendanceMarkStatus", fields: [statusId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([sheetId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_marks")
}

/// A staff member's day: check-in / check-out (button, admin, later a biometric device) and the status.
model StaffAttendance {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  staffId          String    @map("staff_id") @db.Uuid
  date             DateTime  @db.Date
  checkIn          DateTime? @map("check_in") @db.Timestamptz(6)
  checkOut         DateTime? @map("check_out") @db.Timestamptz(6)
  statusId         String?   @map("status_id") @db.Uuid
  late             Boolean   @default(false)
  earlyOut         Boolean   @default(false) @map("early_out")
  /// button (the person), admin (a correction), device, import.
  source           String    @default("button")
  checkInIp        String?   @map("check_in_ip")
  checkOutIp       String?   @map("check_out_ip")
  /// The selfies taken at check-in / check-out (files).
  checkInPhotoId   String?   @map("check_in_photo_id") @db.Uuid
  checkOutPhotoId  String?   @map("check_out_photo_id") @db.Uuid
  /// Where the phone was (GPS), how accurate (m) and how far from the nearest school location (m).
  checkInLat       Float?    @map("check_in_lat")
  checkInLng       Float?    @map("check_in_lng")
  checkInAccuracy  Int?      @map("check_in_accuracy")
  checkInDistance  Int?      @map("check_in_distance")
  checkOutLat      Float?    @map("check_out_lat")
  checkOutLng      Float?    @map("check_out_lng")
  checkOutAccuracy Int?      @map("check_out_accuracy")
  checkOutDistance Int?      @map("check_out_distance")
  /// Distance between the selfie and the enrolled face (smaller = more alike); null = not checked.
  faceDistance     Float?    @map("face_distance")
  /// null = fine; pending = waits for the office (outside the school, face not matching…); approved / rejected.
  approval         String?
  /// Why it waits: outside, no_location, inaccurate, face_mismatch, no_face, no_enrolled_face.
  approvalReasons  String[]  @default([]) @map("approval_reasons")
  decidedBy        String?   @map("decided_by") @db.Uuid
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote     String?   @map("decision_note")
  note             String?
  isDemo           Boolean   @default(false) @map("is_demo")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?   @map("updated_by") @db.Uuid

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff        @relation(fields: [staffId, tenantId], references: [id, tenantId], onDelete: Cascade)
  status MasterValue? @relation("StaffAttendanceStatus", fields: [statusId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, staffId, date])
  @@index([tenantId, date])
  @@map("staff_attendance")
}

/// A student's leave, asked by the parent or the student; approved leave fills the registers of those days.
model StudentLeave {
