// School ERP — database schema.
// Conventions (docs/foundation-design.md §3.4):
//   - tables plural snake_case, columns snake_case (camelCase in code via @map)
//   - uuid keys; every school-owned table has tenant_id (scoped automatically in src/core/db)
//   - audit columns created_at/created_by/updated_at/updated_by (set automatically)
//   - deleted_at = soft delete (excluded from normal queries automatically)
// Change it only through migrations: npm run db:migrate:dev -- --name <what>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Schools ────────────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}

/// A school. Not tenant-scoped itself.
model Tenant {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String       @unique
  name            String
  /// Web address that resolves to this school on the login page (e.g. erp.greenvalley.in).
  domain          String?      @unique
  status          TenantStatus @default(active)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// The plan it is on (Platform console → Plans); its modules and limits are copied to the school and can be changed per school.
  planId          String?      @map("plan_id") @db.Uuid
  /// true = every module; false = only `modules` (product module keys, see modules/platform/catalogue.ts)
  modulesAll      Boolean      @default(true) @map("modules_all")
  modules         String[]     @default([])
  /// { maxStudents?, aiMonthly?, storageMb? } set by the platform (0 / missing = no limit)
  limits          Json         @default("{}")
  contactName     String?      @map("contact_name")
  contactEmail    String?      @map("contact_email")
  contactPhone    String?      @map("contact_phone")
  city            String?
  notes           String?
  suspendedReason String?      @map("suspended_reason")
  /// Set when deletion is requested: everything is removed after this date (the school stays suspended until then).
  deleteAfter     DateTime?    @map("delete_after") @db.Timestamptz(6)

  profile               SchoolProfile?
  users                 User[]
  roles                 Role[]
  settings              TenantSetting[]
  emailTemplates        EmailTemplate[]
  masterValues          MasterValue[]
  academicYears         AcademicYear[]
  classes               SchoolClass[]
  sections              Section[]
  subjects              Subject[]
  classSubjects         ClassSubject[]
  numberSequences       NumberSequence[]
  families              Family[]
  guardians             Guardian[]
  students              Student[]
  enrolments            Enrolment[]
  studentDocuments      StudentDocument[]
  staff                 Staff[]
  staffQualifications   StaffQualification[]
  staffExperience       StaffExperience[]
  staffDocuments        StaffDocument[]
  teachingAssignments   TeachingAssignment[]
  enquiries             Enquiry[]
  enquiryFollowUps      EnquiryFollowUp[]
  feeInstalments        FeeInstalment[]
  feeStructureLines     FeeStructureLine[]
  feeConcessions        FeeConcession[]
  feeConcessionLines    FeeConcessionLine[]
  studentFeeConcessions StudentFeeConcession[]
  feeAdjustments        FeeAdjustment[]
  feeReceipts           FeeReceipt[]
  feeReceiptLines       FeeReceiptLine[]
  paymentGateway        PaymentGateway?
  onlinePayments        OnlinePayment[]
  ttSchedules           TtSchedule[]
  ttSlots               TtSlot[]
  ttDays                TtDay[]
  ttLoads               TtLoad[]
  ttTeacherRules        TtTeacherRule[]
  timetables            Timetable[]
  ttEntries             TtEntry[]
  ttSubstitutions       TtSubstitution[]
  menuCustomizations    MenuCustomization[]
  files                 File[]
  documentTemplates     DocumentTemplate[]
  reportDesigns         ReportDesign[]
  reportSettings        ReportSetting[]
  customReports         CustomReport[]

  holidays         Holiday[]
  attendanceSheets AttendanceSheet[]
  attendanceMarks  AttendanceMark[]
  staffAttendance  StaffAttendance[]

  studentLeaves           StudentLeave[]
  staffAttendanceRequests StaffAttendanceRequest[]

  attendanceLocations AttendanceLocation[]
  staffFaces          StaffFace[]

  staffPhones       StaffPhone[]
  attendanceDevices AttendanceDevice[]

  leaveTypes   LeaveType[]
  leaveEntries LeaveEntry[]
  staffLeaves  StaffLeave[]

  notices      Notice[]
  noticeReads  NoticeRead[]
  schoolEvents SchoolEvent[]

  dashboardLayouts DashboardLayout[]
  yearClasses      YearClass[]
  promotions       StudentPromotion[]
  tcs              TransferCertificate[]

  gradeScales        GradeScale[]
  resultRules        ResultRule[]
  examTerms          ExamTerm[]
  exams              Exam[]
  examSubjects       ExamSubject[]
  examMarks          ExamMark[]
  examNotes          ExamStudentNote[]
  resultPublications ResultPublication[]
  attendancePunches  AttendancePunch[]

  notifications           Notification[]
  messages                Message[]
  messageDeliveries       MessageDelivery[]
  alertConfigs            AlertConfig[]
  messageTemplates        MessageTemplate[]
  notificationPreferences NotificationPreference[]
  customAlerts            CustomAlert[]
  recipientGroups         RecipientGroup[]
  jobRuns                 JobRun[]

  homework            Homework[]
  homeworkSubmissions HomeworkSubmission[]

  chapters  Chapter[]
  questions Question[]
  aiUsage   AiUsage[]

  onlineTests         OnlineTest[]
  onlineTestQuestions OnlineTestQuestion[]
  testAttempts        TestAttempt[]

  learnChats      LearnChat[]
  learnMessages   LearnMessage[]
  practiceQuizzes PracticeQuiz[]

  vehicles         Vehicle[]
  vehicleDocuments VehicleDocument[]
  transportRoutes  TransportRoute[]
  transportStops   TransportStop[]
  studentTransport StudentTransport[]
  trips            Trip[]
  tripPoints       TripPoint[]
  tripEvents       TripEvent[]

  books               Book[]
  bookCopies          BookCopy[]
  libraryLoans        LibraryLoan[]
  libraryReservations LibraryReservation[]
  libraryFines        LibraryFine[]
  libraryStockChecks  LibraryStockCheck[]
