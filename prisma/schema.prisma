  @@map("mess_ratings")
}

/// A person's own dashboard (their order, sizes and filters; their quick links). Without one they get their roles' layouts.
model UserDashboard {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// [{ key, size, filter? }]; null = the roles' layout (only links are their own)
  widgets   Json?
  /// [{ label, href }]
  links     Json     @default("[]")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("user_dashboards")
}

/// A dashboard widget made in the Widget Builder: data (a Report Builder source, its inputs and conditions) and how it is shown.
model CustomWidget {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String   @default("")
  /// { source, params, filters, display: { type, measure, groupBy, bucket, sort, limit, list, tones, caption } }
  definition  Json
  size        String   @default("sm")
  /// Roles it is offered to (besides its maker and widget builders)
  roleIds     String[] @default([]) @map("role_ids") @db.Uuid
  /// Link from its title (a page of the ERP)
  href        String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("custom_widgets")
}

/// A conversation with the AI assistant (each person sees only their own).
model AiChat {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages AiChatMessage[]

  @@unique([id, tenantId])
  @@index([tenantId, userId, updatedAt])
  @@map("ai_chats")
}

/// One message of a conversation: the person's question, or the assistant's answer (with the look-ups it made).
model AiChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  chatId    String   @map("chat_id") @db.Uuid
  /// user | assistant
  role      String
  text      String
  /// [{ label, href }] pages the answer points to
  links     Json     @default("[]")
  /// The look-ups made for the answer: [{ tool, args, ok, error? }]
  steps     Json     @default("[]")
  /// up | down (the person's rating of an answer)
  feedback  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chat   AiChat @relation(fields: [chatId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, chatId, createdAt])
  @@map("ai_chat_messages")
}

// ─── The platform (Klytos Labs): not part of any school ─────────────────────

/// A person who runs the platform console (owner, or support with fewer rights).
model PlatformUser {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique
  name               String
  /// owner | support
  role               String    @default("support")
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  mfaSecretEnc       String?   @map("mfa_secret_enc")
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  /// active | disabled
  status             String    @default("active")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_users")
}

/// A plan schools can be put on: the modules it includes and its limits.
model PlatformPlan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String   @default("")
  modules     String[] @default([])
  /// { maxStudents?, aiMonthly?, storageMb? }
  limits      Json     @default("{}")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_plans")
}

/// What platform staff did (created, suspended, changed a school…).
model PlatformLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  /// The school it was about (no link: the school may be deleted later)
  tenantId   String?  @map("tenant_id") @db.Uuid
  schoolName String?  @map("school_name")
  details    Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([tenantId])
  @@map("platform_logs")
}

/// A notice to schools: a maintenance banner, or a "What's new" note after an update.
model PlatformNotice {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// banner | news
  kind      String
  title     String
  body      String    @default("")
  /// all | admins (school admins and principals)
  audience  String    @default("all")
  startsAt  DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime? @map("ends_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([kind, startsAt])
  @@map("platform_notices")
}
