  code      String?
  /// cash | bank | other
  kind      String   @default("other")
  /// Bank: { bank, accountNo, ifsc, branch }
  details   Json     @default("{}")
  /// The bank account fees paid other than in cash go into.
  isDefault Boolean  @default(false) @map("is_default")
