{
  "name": "cms-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && node scripts/build.js",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "tenant:create": "tsx src/scripts/tenant-create.ts",
    "platform:owner": "tsx src/scripts/platform-owner.ts",
    "isolation:check": "tsx src/scripts/isolation-check.ts",
    "user:reset-password": "tsx src/scripts/reset-password.ts",
    "roles:apply-defaults": "tsx src/scripts/apply-default-grants.ts",
    "starter:seed": "tsx src/scripts/seed-starter-data.ts",
    "masters:seed": "tsx src/scripts/seed-starter-data.ts",
    "demo:seed": "tsx src/scripts/demo-data.ts",
    "demo:clear": "tsx src/scripts/demo-data.ts --clear",
    "jasper": "node scripts/jasper.js",
    "files:to-cloudinary": "tsx src/scripts/files-to-cloudinary.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@vladmandic/face-api": "1.7.15",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jpeg-js": "0.4.4",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "otplib": "^12.0.1",
    "puppeteer-core": "^23.11.1",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "esbuild": "0.27.7",
    "eslint": "^9.17.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.10.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
