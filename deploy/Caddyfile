# Every school's address gets HTTPS automatically: <code>.{PLATFORM_DOMAIN} and schools' own domains.
# A certificate is only issued for an address the backend confirms belongs to a school (or the
# platform itself), so nobody can make the server ask for certificates for random names.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://backend:8000/api/platform-info/tls-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode gzip zstd

	# The API (and uploaded files) go to the backend; everything else is the web app.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

http:// {
	redir https://{host}{uri} permanent
}
