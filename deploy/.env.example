# Production settings for docker-compose.prod.yml. Copy to .env and fill in. Never commit .env.

# The platform's domain: schools are at <code>.<PLATFORM_DOMAIN>, the console at console.<PLATFORM_DOMAIN>,
# and app.<PLATFORM_DOMAIN> is the shared address that asks for the school code.
PLATFORM_DOMAIN=klytos.in
PLATFORM_NAME=Klytos
# Website demo requests are emailed here (empty = every console owner).
PLATFORM_LEADS_EMAIL=

# Mobile app. Push: the Firebase project's service-account key (JSON, or the JSON base64-encoded).
# Empty = no push (in-app notifications still work). Versions: older apps are asked to update.
FCM_SERVICE_ACCOUNT=
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_ANDROID_URL=
APP_IOS_URL=
# Let's Encrypt writes here about certificates.
ACME_EMAIL=

# Database password (long and random: openssl rand -hex 24).
POSTGRES_PASSWORD=
# Shared secret between the backend and the report service (openssl rand -hex 24).
JASPER_TOKEN=

# Signing key for sign-ins (RS256 private key, one line with \n) and the key for stored secrets (64 hex).
JWT_PRIVATE_KEY=
MFA_ENCRYPTION_KEY=
SALT_ROUNDS=12

# Browsers allowed to call the API: the frontend is on the same address, so leave empty.
CORS_ORIGINS=
# Leave empty in production: an unknown address shows "find your school" instead of a default school.
DEFAULT_TENANT_CODE=
# Database connections the backend opens (PgBouncer shares them).
DB_POOL_SIZE=10

# The platform's mail account (schools without their own send as "<School> via Klytos").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Uploaded files: local = the server's disk (the "files" volume, back it up); cloudinary = Cloudinary (fill the three below).
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Off-machine backups: an rclone remote (configure rclone.conf), e.g. oci:erp-backups. Empty = only on this machine.
BACKUP_REMOTE=
